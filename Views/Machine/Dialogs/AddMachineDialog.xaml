<Window x:Class="AutomaticOnlineHostComputer.Views.Machine.Dialogs.AddMachineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加机器"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#BFC8D6" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="线路" Margin="0,6" VerticalAlignment="Center"/>
                <ComboBox x:Name="LineNoComboBox" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left">
                    <ComboBoxItem Content="1号线" IsSelected="True"/>
                    <ComboBoxItem Content="2号线"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Text="站位编码" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="StationCodeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="2" Text="机器名称" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="3" Text="机器类型" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="TypeNameTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="4" Text="区域" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="AreaNameTextBox" Grid.Row="4" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="5" Text="机号" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="MachineNoTextBox" Grid.Row="5" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="6" Text="IP" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="IpTextBox" Grid.Row="6" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="7" Text="端口" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="PortTextBox" Grid.Row="7" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="0"/>

                <TextBlock Grid.Row="8" Text="X/Y/Z" Margin="0,6" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                    <TextBox x:Name="XTextBox" Width="70" Text="0"/><TextBox x:Name="YTextBox" Width="70" Margin="8,0,0,0" Text="0"/><TextBox x:Name="ZTextBox" Width="70" Margin="8,0,0,0" Text="0"/>
                </StackPanel>

                <TextBlock Grid.Row="9" Text="X/Y/Z位移" Margin="0,6" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                    <TextBox x:Name="XDisTextBox" Width="70" Text="0"/><TextBox x:Name="YDisTextBox" Width="70" Margin="8,0,0,0" Text="0"/><TextBox x:Name="ZDisTextBox" Width="70" Margin="8,0,0,0" Text="0"/>
                </StackPanel>

                <TextBlock Grid.Row="10" Text="抖动" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="DisShakeTextBox" Grid.Row="10" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="0"/>

                <TextBlock Grid.Row="11" Text="状态" Margin="0,6" VerticalAlignment="Center"/>
                <ComboBox x:Name="StateComboBox" Grid.Row="11" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left">
                    <ComboBoxItem Content="启用" IsSelected="True"/>
                    <ComboBoxItem Content="检修"/>
                    <ComboBoxItem Content="停用"/>
                </ComboBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="确定" Width="90" Height="32" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="取消" Width="90" Height="32" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
