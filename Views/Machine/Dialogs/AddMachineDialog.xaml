<Window
    x:Class="AutomaticOnlineHostComputer.Views.Machine.Dialogs.AddMachineDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="添加机器"
    Width="1020"
    Height="700"
    Background="#E9E9E9"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧参数区  -->
            <Border
                Grid.Column="0"
                Padding="8"
                Background="#E9E9E9"
                BorderBrush="#D0D0D0"
                BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="添加线路" />
                        <ComboBox
                            x:Name="LineNoComboBox"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4">
                            <ComboBoxItem Content="一号线" IsSelected="True" />
                            <ComboBoxItem Content="二号线" />
                            <ComboBoxItem Content="总线路" />
                        </ComboBox>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="机器名称" />
                        <TextBox
                            x:Name="NameTextBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="机器类型" />
                        <ComboBox
                            x:Name="TypeNameComboBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4">
                            <ComboBoxItem Content="斜床" IsSelected="True" />
                            <ComboBoxItem Content="双头镗" />
                            <ComboBoxItem Content="研磨机" />
                            <ComboBoxItem Content="打标机" />
                            <ComboBoxItem Content="物料架" />
                            <ComboBoxItem Content="货叉" />
                        </ComboBox>

                        <TextBlock
                            Grid.Row="3"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="X坐标" />
                        <TextBox
                            x:Name="XTextBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="4"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="Y坐标" />
                        <TextBox
                            x:Name="YTextBox"
                            Grid.Row="4"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="5"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="Z坐标" />
                        <TextBox
                            x:Name="ZTextBox"
                            Grid.Row="5"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="6"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="下降Z坐标" />
                        <TextBox
                            x:Name="DownZTextBox"
                            Grid.Row="6"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="7"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="上升Z坐标" />
                        <TextBox
                            x:Name="UpZTextBox"
                            Grid.Row="7"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="8"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="绝对坐标" />
                        <TextBox
                            x:Name="AbsolutePosTextBox"
                            Grid.Row="8"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="9"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="X位移" />
                        <TextBox
                            x:Name="XDisTextBox"
                            Grid.Row="9"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="10"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="Y位移" />
                        <TextBox
                            x:Name="YDisTextBox"
                            Grid.Row="10"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="11"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="Z位移" />
                        <TextBox
                            x:Name="ZDisTextBox"
                            Grid.Row="11"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="12"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="抖动距离" />
                        <TextBox
                            x:Name="DisShakeTextBox"
                            Grid.Row="12"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="13"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="加工范围" />
                        <TextBox
                            x:Name="WorkRangeTextBox"
                            Grid.Row="13"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="14"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="IP地址" />
                        <TextBox
                            x:Name="IpTextBox"
                            Grid.Row="14"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <TextBlock
                            Grid.Row="15"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Text="端口" />
                        <TextBox
                            x:Name="PortTextBox"
                            Grid.Row="15"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4" />

                        <!--  当前位置（PLC实时值）—— TODO：编辑后可直接写入PLC寄存器触发绝对移动  -->
                        <TextBlock
                            Grid.Row="16"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Foreground="#B45309"
                            Text="当前X坐标" />
                        <TextBox
                            x:Name="CurrentXTextBox"
                            Grid.Row="16"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4"
                            ToolTip="PLC实时值 D5018~D5019，编辑后通过绝对位移走到此坐标" />

                        <TextBlock
                            Grid.Row="17"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Foreground="#B45309"
                            Text="当前Y坐标" />
                        <TextBox
                            x:Name="CurrentYTextBox"
                            Grid.Row="17"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4"
                            ToolTip="PLC实时值 D5022" />

                        <TextBlock
                            Grid.Row="18"
                            Margin="0,8"
                            VerticalAlignment="Center"
                            Foreground="#B45309"
                            Text="当前Z坐标" />
                        <TextBox
                            x:Name="CurrentZTextBox"
                            Grid.Row="18"
                            Grid.Column="1"
                            Height="28"
                            Margin="4,4,0,4"
                            ToolTip="PLC实时值 D5025" />

                        <StackPanel
                            Grid.Row="19"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Width="88"
                                Height="34"
                                Margin="0,0,10,0"
                                Click="Save_Click"
                                Content="确定" />
                            <Button
                                Width="88"
                                Height="34"
                                Click="Close_Click"
                                Content="取消" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!--  右侧参数表  -->
            <Border
                Grid.Column="2"
                Background="#E9E9E9"
                BorderBrush="#F08C3A"
                BorderThickness="1">
                <Grid>
                    <DataGrid
                        Margin="0"
                        AutoGenerateColumns="False"
                        Background="#E9E9E9"
                        CanUserAddRows="False"
                        GridLinesVisibility="All"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="#D0D0D0"
                        IsReadOnly="True"
                        VerticalGridLinesBrush="#D0D0D0">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ParamCode}"
                                Header="参数代号" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ParamNo}"
                                Header="参数编号" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ParamName}"
                                Header="参数名称" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ParamAddress}"
                                Header="参数地址" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ParamExpr}"
                                Header="参数表达式" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
