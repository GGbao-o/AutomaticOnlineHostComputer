<Window x:Class="AutomaticOnlineHostComputer.Views.Machine.Dialogs.AddMachineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加机器"
        Width="980" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F0F2F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="添加机器" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                <Button Content="✕"
                        Width="28" Height="28"
                        DockPanel.Dock="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#D14343"
                        FontWeight="Bold"
                        Click="Close_Click"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="添加线路" Margin="0,6" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="220">
                            <ComboBoxItem Content="一号线" IsSelected="True"/>
                            <ComboBoxItem Content="二号线"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="机器名称" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Text="机器类型" Margin="0,6" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="斜床" IsSelected="True"/>
                            <ComboBoxItem Content="双头镗"/>
                            <ComboBoxItem Content="研磨机"/>
                            <ComboBoxItem Content="打标机"/>
                            <ComboBoxItem Content="物料架"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Text="X坐标" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="4" Text="Y坐标" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="5" Text="Z坐标" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="6" Text="下降Z坐标" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="7" Text="上升Z坐标" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="8" Text="绝对坐标" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="9" Text="X位移" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="9" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="10" Text="Y位移" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="11" Text="Z位移" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="11" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="12" Text="抖动距离" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="13" Text="加工范围" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="13" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="14" Text="图标" Margin="0,6" VerticalAlignment="Center"/>
                        <Border Grid.Row="14" Grid.Column="1" Margin="0,6" Width="80" Height="80" Background="#E5E7EB" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Left"/>
                        <Button Grid.Row="14" Grid.Column="1" Content="选择" Width="60" Height="30" HorizontalAlignment="Left" Margin="92,25,0,0" VerticalAlignment="Top"/>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="参数配置" FontWeight="Bold"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  Margin="8"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#D9E0EA"
                                  VerticalGridLinesBrush="#D9E0EA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="参数代号" Binding="{Binding Code}" Width="100"/>
                                <DataGridTextColumn Header="参数编号" Binding="{Binding No}" Width="100"/>
                                <DataGridTextColumn Header="参数名称" Binding="{Binding Name}" Width="140"/>
                                <DataGridTextColumn Header="参数地址" Binding="{Binding Addr}" Width="100"/>
                                <DataGridTextColumn Header="参数表达式" Binding="{Binding Exp}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="确定" Width="80" Height="32" Margin="0,0,8,0"/>
            <Button Content="取消" Width="80" Height="32" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>