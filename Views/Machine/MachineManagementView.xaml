<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.Machine.MachineManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F0F2F5">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="4" Orientation="Horizontal">
                    <TextBlock
                        Margin="4,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="机器管理" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1500" MinHeight="700">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid
                            x:Name="MachineGrid"
                            MinHeight="90"
                            Margin="8,0,8,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#D9E0EA"
                            IsReadOnly="True"
                            VerticalGridLinesBrush="#D9E0EA"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Id}"
                                    Header="机号" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding Name}"
                                    Header="机器名称" />
                                <!-- <DataGridTextColumn Header="位置" Binding="{Binding Position}" Width="120" /> -->
                                <!-- <DataGridTextColumn Header="缩略图" Binding="{Binding Thumb}" Width="120" /> -->
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding X}"
                                    Header="标定X" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Y}"
                                    Header="标定Y" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Z}"
                                    Header="标定Z" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding CurrentX}"
                                    Header="当前X" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding CurrentY}"
                                    Header="当前Y" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding CurrentZ}"
                                    Header="当前Z" />
                                <DataGridTextColumn
                                    Width="55"
                                    Binding="{Binding DeltaX}"
                                    Header="ΔX" />
                                <DataGridTextColumn
                                    Width="55"
                                    Binding="{Binding DeltaY}"
                                    Header="ΔY" />
                                <DataGridTextColumn
                                    Width="55"
                                    Binding="{Binding DeltaZ}"
                                    Header="ΔZ" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding XOffset}"
                                    Header="X轴偏移" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding YOffset}"
                                    Header="Y轴偏移" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding ZOffset}"
                                    Header="Z轴偏移" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Shake}"
                                    Header="抖动" />
                            </DataGrid.Columns>
                        </DataGrid>


                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="8,0,0,0"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <StackPanel Margin="8">
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="AddMachine_click"
                    Content="添加机器" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="EditMachine_Click"
                    Content="编辑机器" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="DeleteMachine_Click"
                    Content="删除机器" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Content="刷新图标" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>