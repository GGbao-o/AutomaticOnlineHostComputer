<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.Machine.MachineManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12,9" Background="#26323F" CornerRadius="6,6,0,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="机器管理" />
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1100" MinHeight="700">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid
                            x:Name="MachineGrid"
                            MinHeight="90"
                            Margin="10"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#D9E0EA"
                            IsReadOnly="True"
                            VerticalGridLinesBrush="#D9E0EA"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding StationCode}"
                                    Header="站号" />
                                <DataGridTextColumn
                                    Width="160"
                                    Binding="{Binding Name}"
                                    Header="名称" />
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding TypeName}"
                                    Header="类型" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding Ip}"
                                    Header="IP" />
                                <DataGridTextColumn
                                    Width="60"
                                    Binding="{Binding Port}"
                                    Header="端口" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding X}"
                                    Header="标定X" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Y}"
                                    Header="标定Y" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Z}"
                                    Header="标定Z" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding XOffset}"
                                    Header="X偏移" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding YOffset}"
                                    Header="Y偏移" />
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding ZOffset}"
                                    Header="Z偏移" />
                            </DataGrid.Columns>
                        </DataGrid>


                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="10,0,0,0"
            Padding="8"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="操作" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="AddMachine_click"
                    Content="添加机器" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="EditMachine_Click"
                    Content="编辑机器" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="DeleteMachine_Click"
                    Content="删除机器" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Content="刷新图标" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
