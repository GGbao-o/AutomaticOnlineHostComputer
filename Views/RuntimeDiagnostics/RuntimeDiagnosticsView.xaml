<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.RuntimeDiagnostics.RuntimeDiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#E9EEF5">
    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CED8E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="KpiStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Width" Value="178" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="VerticalGridLinesBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LevelText}" Value="等待">
                    <Setter Property="Background" Value="#F8FAFC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelText}" Value="警告">
                    <Setter Property="Background" Value="#FEF3C7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelText}" Value="人工确认">
                    <Setter Property="Background" Value="#FEE2E2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#172033" Text="运行诊断" />
            <TextBlock Margin="0,5,0,0" Foreground="#627084"
                       Text="只解释程序已有的内存状态；不额外读取设备、不写寄存器、不控制或恢复流程。" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,18,0,14">
            <Border Style="{StaticResource KpiStyle}" BorderBrush="#86EFAC">
                <StackPanel>
                    <TextBlock Foreground="#166534" Text="前端可接板线路" />
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="#16A34A" Text="{Binding ReadyLineCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiStyle}" BorderBrush="#FCA5A5">
                <StackPanel>
                    <TextBlock Foreground="#991B1B" Text="1/2号线通信断开" />
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="#DC2626" Text="{Binding CommunicationIssueCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiStyle}" BorderBrush="#FCD34D">
                <StackPanel>
                    <TextBlock Foreground="#92400E" Text="前端快照异常" />
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="#D97706" Text="{Binding StaleSnapshotCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiStyle}" BorderBrush="#FCA5A5">
                <StackPanel>
                    <TextBlock Foreground="#991B1B" Text="需要人工确认" />
                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="#DC2626" Text="{Binding ManualConfirmationCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiStyle}" Width="235" Margin="0">
                <StackPanel>
                    <TextBlock Foreground="#475569" Text="最近刷新" />
                    <TextBlock Margin="0,9,0,0" FontSize="15" FontWeight="SemiBold"
                               Foreground="#172033" Text="{Binding LastRefreshText}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,0,0,12" Padding="10">
            <TextBlock Foreground="#64748B" Text="说明：‘等待’可能只是正常节拍条件未满足；黄色需要检查通信/快照，红色需要人工核对现场。此页面没有操作按钮。" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="14,12" FontSize="16" FontWeight="SemiBold" Foreground="#172033"
                               Text="当前等待与1/2号线设备健康" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HealthItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="范围" Width="105" Binding="{Binding Scope}" />
                            <DataGridTextColumn Header="项目" Width="145" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="等级" Width="68" Binding="{Binding LevelText}" />
                            <DataGridTextColumn Header="状态" Width="100" Binding="{Binding State}" />
                            <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Detail}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="14,12,14,4" FontSize="16" FontWeight="SemiBold" Foreground="#172033"
                               Text="天车任务与人工确认" />
                    <TextBlock Grid.Row="1" Margin="14,0,14,9" Foreground="#64748B"
                               TextWrapping="Wrap" Text="{Binding AttentionEmptyText}" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding AttentionItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="范围" Width="78" Binding="{Binding Scope}" />
                            <DataGridTextColumn Header="项目" Width="105" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="等级" Width="72" Binding="{Binding LevelText}" />
                            <DataGridTextColumn Header="状态" Width="88" Binding="{Binding State}" />
                            <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Detail}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
