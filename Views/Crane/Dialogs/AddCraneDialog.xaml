<Window x:Class="AutomaticOnlineHostComputer.Views.Crane.Dialogs.AddCraneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加天车"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#BFC8D6" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="线路" Margin="0,6" VerticalAlignment="Center"/>
                <ComboBox x:Name="LineNoComboBox" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left">
                    <ComboBoxItem Content="1号线" IsSelected="True"/>
                    <ComboBoxItem Content="2号线"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Text="天车编号" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="CraneNoTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="2" Text="天车名称" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="CraneNameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="3" Text="IP" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="IpTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="4" Text="端口" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="PortTextBox" Grid.Row="4" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="6000"/>

                <TextBlock Grid.Row="5" Text="编码器IP" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="EncoderIpTextBox" Grid.Row="5" Grid.Column="1" Margin="0,6" Width="240" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="6" Text="编码器端口" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="EncoderPortTextBox" Grid.Row="6" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="502"/>

                <TextBlock Grid.Row="7" Text="编码器机号" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="EncoderNoTextBox" Grid.Row="7" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="1"/>

                <TextBlock Grid.Row="8" Text="原点X" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="OriginXTextBox" Grid.Row="8" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="0"/>

                <TextBlock Grid.Row="9" Text="原点Y" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="OriginYTextBox" Grid.Row="9" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="0"/>

                <TextBlock Grid.Row="10" Text="原点Z" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="OriginZTextBox" Grid.Row="10" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="0"/>

                <TextBlock Grid.Row="11" Text="天车宽度" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="WidthTextBox" Grid.Row="11" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left" Text="0"/>

                <TextBlock Grid.Row="12" Text="状态" Margin="0,6" VerticalAlignment="Center"/>
                <ComboBox x:Name="WorkStaComboBox" Grid.Row="12" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left">
                    <ComboBoxItem Content="启用" IsSelected="True"/>
                    <ComboBoxItem Content="检修"/>
                    <ComboBoxItem Content="停用"/>
                </ComboBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="确定" Width="90" Height="32" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="取消" Width="90" Height="32" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
