<Window x:Class="AutomaticOnlineHostComputer.Views.Crane.Dialogs.AddCraneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加天车"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F0F2F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="添加天车" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                <Button Content="✕"
                        Width="28" Height="28"
                        DockPanel.Dock="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#D14343"
                        FontWeight="Bold"
                        Click="Close_Click"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid MinWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="添加位置" Margin="0,6" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="0" Margin="110,6,10,6" HorizontalAlignment="Left" Width="160">
                        <ComboBoxItem Content="1号线" IsSelected="True"/>
                        <ComboBoxItem Content="2号线"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="天车编号" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Text="天车名称" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="3" Text="IP地址" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="4" Text="天车端口" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left" Text="6000"/>

                    <TextBlock Grid.Row="5" Text="编码器IP" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="6" Text="编码器端口" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left" Text="502"/>

                    <TextBlock Grid.Row="7" Text="编码器机号" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="7" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left" Text="1"/>

                    <TextBlock Grid.Row="8" Text="绝对位置偏移" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="8" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="9" Text="Z轴正限位" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="9" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="10" Text="Z轴负限位" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="10" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="11" Text="X轴螺距" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="11" Grid.Column="0" Margin="110,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="天车原点X坐标" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="1" Text="天车原点Y坐标" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="1" Text="天车原点Z坐标" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="3" Grid.Column="1" Text="天车宽度" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="4" Grid.Column="1" Text="X轴减速比" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Y轴减速比" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Z轴减速比" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="7" Grid.Column="1" Text="X轴起始位置" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="8" Grid.Column="1" Text="X轴结束位置" Margin="0,6" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Margin="130,6,10,6" Width="220" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="9" Grid.Column="1" Text="图标" Margin="0,6" VerticalAlignment="Center"/>
                    <Border Grid.Row="9" Grid.Column="1" Margin="130,6,10,6" Width="160" Height="110" Background="#E5E7EB" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Left"/>
                    <Button Grid.Row="9" Grid.Column="1" Content="选择" Width="60" Height="30" HorizontalAlignment="Left" Margin="300,40,0,0" VerticalAlignment="Top"/>

                    <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="130,8,10,6">
                        <RadioButton Content="启用" IsChecked="True" Margin="0,0,24,0"/>
                        <RadioButton Content="检修" Margin="0,0,24,0"/>
                        <RadioButton Content="停用"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="确定" Width="80" Height="32" Margin="0,0,8,0"/>
            <Button Content="取消" Width="80" Height="32" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>