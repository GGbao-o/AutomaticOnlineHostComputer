<UserControl x:Class="AutomaticOnlineHostComputer.Views.Crane.CraneManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12,9" Background="#26323F" CornerRadius="6,6,0,0">
                    <TextBlock Text="天车管理" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center" />
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1200" MinHeight="650">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="CraneGrid"
                                   Margin="10"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#D9E0EA"
                                  VerticalGridLinesBrush="#D9E0EA"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  MinHeight="90">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="60" />
                                <DataGridTextColumn Header="天车名称" Binding="{Binding Name}" Width="140" />
                                <!-- <DataGridTextColumn Header="缩略图" Binding="{Binding Thumb}" Width="110" /> -->
                                <DataGridTextColumn Header="标定X" Binding="{Binding X}" Width="70" />
                                <DataGridTextColumn Header="标定Y" Binding="{Binding Y}" Width="70" />
                                <DataGridTextColumn Header="标定Z" Binding="{Binding Z}" Width="70" />
                                <DataGridTextColumn Header="当前X" Binding="{Binding CurrentX}" Width="80" />
                                <DataGridTextColumn Header="当前Y" Binding="{Binding CurrentY}" Width="80" />
                                <DataGridTextColumn Header="当前Z" Binding="{Binding CurrentZ}" Width="80" />
                                <DataGridTextColumn Header="ΔX" Binding="{Binding DeltaX}" Width="60" />
                                <DataGridTextColumn Header="ΔY" Binding="{Binding DeltaY}" Width="60" />
                                <DataGridTextColumn Header="ΔZ" Binding="{Binding DeltaZ}" Width="60" />
                                <DataGridTextColumn Header="IP地址" Binding="{Binding Ip}" Width="130" />
                                <DataGridTextColumn Header="天车端口" Binding="{Binding Port}" Width="100" />
                                <DataGridTextColumn Header="编码器IP" Binding="{Binding EncoderIp}" Width="140" />
                                <DataGridTextColumn Header="编码器端口" Binding="{Binding EncoderPort}" Width="100" />
                                <DataGridTextColumn Header="编码器机号" Binding="{Binding EncoderNo}" Width="100" />
                                <DataGridTextColumn Header="天车宽度" Binding="{Binding Width}" Width="100" />
                                <DataGridTextColumn Header="天车状态" Binding="{Binding State}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>


                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="10,0,0,0"
                Padding="8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="操作" />
                <Button Content="添加天车" Height="34" Margin="0,0,0,8" Click="AddCrane_Click" />
                <Button Content="编辑天车" Height="34" Margin="0,0,0,8" Click="EditCrane_Click" />
                <Button Content="删除天车" Height="34" Margin="0,0,0,8" Click="DeleteCrane_Click" />
                <Button Content="刷新图标" Height="34" Margin="0,0,0,8" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
