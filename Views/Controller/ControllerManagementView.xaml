<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.Controller.ControllerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F0F2F5">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="4" Orientation="Horizontal">
                    <TextBlock
                        Margin="4,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="控制器管理" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1200" MinHeight="650">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid
                            x:Name="ControllerGrid"
                            MinHeight="90"
                            Margin="8,0,8,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#D9E0EA"
                            IsReadOnly="True"
                            VerticalGridLinesBrush="#D9E0EA"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Id}"
                                    Header="机号" />
                                <DataGridTextColumn
                                    Width="160"
                                    Binding="{Binding Name}"
                                    Header="控制器名称" />
                                <!-- <DataGridTextColumn Header="缩略图" Binding="{Binding Thumb}" Width="120" /> -->
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding Type}"
                                    Header="设备类型" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding Ip}"
                                    Header="IP地址" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Port}"
                                    Header="端口" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding State}"
                                    Header="设备状态" />
                            </DataGrid.Columns>
                        </DataGrid>


                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="8,0,0,0"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <StackPanel Margin="8">
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="AddController_click"
                    Content="添加设备" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="EditController_Click"
                    Content="编辑设备" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="DeleteController_Click"
                    Content="删除设备" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Content="刷新图标" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>