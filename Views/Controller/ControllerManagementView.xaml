<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.Controller.ControllerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12,9" Background="#26323F" CornerRadius="6,6,0,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="控制器管理" />
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1200" MinHeight="650">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid
                            x:Name="ControllerGrid"
                            MinHeight="90"
                            Margin="10"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#D9E0EA"
                            IsReadOnly="True"
                            VerticalGridLinesBrush="#D9E0EA"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Id}"
                                    Header="机号" />
                                <DataGridTextColumn
                                    Width="160"
                                    Binding="{Binding Name}"
                                    Header="控制器名称" />
                                <!-- <DataGridTextColumn Header="缩略图" Binding="{Binding Thumb}" Width="120" /> -->
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding Type}"
                                    Header="设备类型" />
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding Ip}"
                                    Header="IP地址" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Port}"
                                    Header="端口" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding State}"
                                    Header="设备状态" />
                            </DataGrid.Columns>
                        </DataGrid>


                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="10,0,0,0"
            Padding="8"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="操作" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="AddController_click"
                    Content="添加设备" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="EditController_Click"
                    Content="编辑设备" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="DeleteController_Click"
                    Content="删除设备" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Content="刷新图标" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
