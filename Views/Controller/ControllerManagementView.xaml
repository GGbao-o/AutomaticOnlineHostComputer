<UserControl x:Class="AutomaticOnlineHostComputer.Views.Controller.ControllerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="控制器管理" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="4,0,10,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1200" MinHeight="650">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid Margin="8,0,8,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#D9E0EA"
                                  VerticalGridLinesBrush="#D9E0EA"
                                  MinHeight="90">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="机号" Binding="{Binding Id}" Width="70"/>
                                <DataGridTextColumn Header="控制器名称" Binding="{Binding Name}" Width="160"/>
                                <DataGridTextColumn Header="缩略图" Binding="{Binding Thumb}" Width="120"/>
                                <DataGridTextColumn Header="设备类型" Binding="{Binding Type}" Width="120"/>
                                <DataGridTextColumn Header="IP地址" Binding="{Binding Ip}" Width="150"/>
                                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="80"/>
                                <DataGridTextColumn Header="设备状态" Binding="{Binding State}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
            <StackPanel Margin="8">
                <Button Content="添加设备" Height="34" Margin="0,0,0,8"/>
                <Button Content="编辑设备" Height="34" Margin="0,0,0,8"/>
                <Button Content="删除设备" Height="34" Margin="0,0,0,8"/>
                <Button Content="刷新图标" Height="34" Margin="0,0,0,8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
