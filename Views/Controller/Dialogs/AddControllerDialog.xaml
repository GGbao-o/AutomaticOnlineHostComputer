<Window x:Class="AutomaticOnlineHostComputer.Views.Controller.Dialogs.AddControllerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加控制器"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F0F2F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Padding="12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="添加控制器" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                <Button Content="✕"
                        Width="28" Height="28"
                        DockPanel.Dock="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#D14343"
                        FontWeight="Bold"
                        Click="Close_Click"/>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <Border Grid.Row="1" Margin="0,12,0,12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧表单 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 设备名称 -->
                        <TextBlock Text="设备名称" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                        <!-- 设备类型 -->
                        <TextBlock Grid.Row="1" Text="设备类型" Margin="0,6" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left">
                            <ComboBoxItem Content="研磨机" IsSelected="True"/>
                            <ComboBoxItem Content="斜床"/>
                            <ComboBoxItem Content="双头镗"/>
                            <ComboBoxItem Content="打标机"/>
                            <ComboBoxItem Content="物料架"/>
                        </ComboBox>

                        <!-- IP地址 -->
                        <TextBlock Grid.Row="2" Text="IP地址" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                        <!-- 端口 -->
                        <TextBlock Grid.Row="3" Text="端口" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                        <!-- 机号 -->
                        <TextBlock Grid.Row="4" Text="机号" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6" Width="180" HorizontalAlignment="Left"/>

                        <!-- 图标 -->
                        <TextBlock Grid.Row="5" Text="图标" Margin="0,6" VerticalAlignment="Center"/>
                        <Grid Grid.Row="5" Grid.Column="1" Margin="0,6">
                            <Border Width="80" Height="80" Background="#E5E7EB" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Left"/>
                            <Button Content="选择" Width="60" Height="30" HorizontalAlignment="Left" Margin="92,25,0,0" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- 状态 -->
                        <TextBlock Grid.Row="6" Text="状态" Margin="0,6" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                            <RadioButton Content="启用" IsChecked="True" Margin="0,0,16,0" GroupName="ControllerStatus"/>
                            <RadioButton Content="检修" Margin="0,0,16,0" GroupName="ControllerStatus"/>
                            <RadioButton Content="停用" GroupName="ControllerStatus"/>
                        </StackPanel>

                        <!-- 底部按钮 -->
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="确定" Width="80" Height="32" Margin="0,0,8,0"/>
                            <Button Content="取消" Width="80" Height="32" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 右侧表格 -->
                <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="1"
                                  Margin="8"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#D9E0EA"
                                  VerticalGridLinesBrush="#D9E0EA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="代号" Binding="{Binding Code}" Width="100"/>
                                <DataGridTextColumn Header="功能" Binding="{Binding Function}" Width="140"/>
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="120"/>
                                <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="100"/>
                                <DataGridTextColumn Header="读写状态" Binding="{Binding ReadWriteStatus}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>