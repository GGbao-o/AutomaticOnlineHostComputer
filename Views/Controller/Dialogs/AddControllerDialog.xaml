<Window x:Class="AutomaticOnlineHostComputer.Views.Controller.Dialogs.AddControllerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加控制器"
        Width="560" Height="430"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#BFC8D6" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="设备名称" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="NameTextBox" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="1" Text="设备类型" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="TypeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="2" Text="IP地址" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="IpTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="3" Text="端口" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="PortTextBox" Grid.Row="3" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left" Text="0"/>

                <TextBlock Grid.Row="4" Text="设备号" Margin="0,6" VerticalAlignment="Center"/>
                <TextBox x:Name="DeviceNoTextBox" Grid.Row="4" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="5" Text="状态" Margin="0,6" VerticalAlignment="Center"/>
                <ComboBox x:Name="StateComboBox" Grid.Row="5" Grid.Column="1" Margin="0,6" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="启用" IsSelected="True"/>
                    <ComboBoxItem Content="检修"/>
                    <ComboBoxItem Content="停用"/>
                </ComboBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="确定" Width="90" Height="32" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="取消" Width="90" Height="32" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
