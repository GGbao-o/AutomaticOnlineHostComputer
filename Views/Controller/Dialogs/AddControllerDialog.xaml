<Window x:Class="AutomaticOnlineHostComputer.Views.Controller.Dialogs.AddControllerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加控制器"
        Width="1020" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#E9E9E9">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧录入区 -->
            <Border Grid.Column="0" Background="#E9E9E9" BorderBrush="#D0D0D0" BorderThickness="1" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="设备名称" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="NameTextBox" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="1" Text="设备类型" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="TypeTextBox" Grid.Row="1" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="2" Text="IP地址" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="IpTextBox" Grid.Row="2" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="3" Text="端口" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="PortTextBox" Grid.Row="3" Grid.Column="1" Margin="4,4,0,4" Height="28" Text="0"/>

                        <TextBlock Grid.Row="4" Text="设备号" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="DeviceNoTextBox" Grid.Row="4" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="5" Text="状态" Margin="0,8" VerticalAlignment="Center"/>
                        <ComboBox x:Name="StateComboBox" Grid.Row="5" Grid.Column="1" Margin="4,4,0,4" Height="28">
                            <ComboBoxItem Content="启用" IsSelected="True"/>
                            <ComboBoxItem Content="检修"/>
                            <ComboBoxItem Content="停用"/>
                        </ComboBox>

                        <TextBlock Grid.Row="6" Text="图标" Margin="0,8" VerticalAlignment="Center"/>
                        <Grid Grid.Row="6" Grid.Column="1" Margin="4,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="96" Height="70" Background="#D8D8D8" BorderBrush="#C0C0C0" BorderThickness="1"/>
                            <Button Grid.Column="1" Content="选择" Width="56" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>

                        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Content="确定" Width="88" Height="34" Margin="0,0,10,0" Click="Save_Click"/>
                            <Button Content="取消" Width="88" Height="34" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 右侧寄存器表 -->
            <Border Grid.Column="2" BorderBrush="#F08C3A" BorderThickness="1" Background="#E9E9E9">
                <DataGrid Margin="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#D0D0D0"
                          VerticalGridLinesBrush="#D0D0D0"
                          Background="#E9E9E9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="参数代号" Binding="{Binding ParamCode}" Width="*" />
                        <DataGridTextColumn Header="参数地址" Binding="{Binding ParamAddress}" Width="*" />
                        <DataGridTextColumn Header="参数长度" Binding="{Binding ParamLength}" Width="*" />
                        <DataGridTextColumn Header="参数类型" Binding="{Binding ParamType}" Width="*" />
                        <DataGridTextColumn Header="读写" Binding="{Binding ReadWrite}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
