<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.AttentionMonitor.AttentionMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#E9EEF5">
    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CED8E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="KpiStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="VerticalGridLinesBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#172033" Text="异常监控" />
            <TextBlock Margin="0,5,0,0" Foreground="#627084"
                       Text="仅保留当前程序生命周期内需要人工关注的异常、警告和应急操作；程序关闭后自动清空。" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,18,0,16">
            <Border Style="{StaticResource KpiStyle}" BorderBrush="#FCA5A5">
                <StackPanel><TextBlock Foreground="#B91C1C" Text="红色安全异常" /><TextBlock FontSize="26" FontWeight="Bold" Foreground="#DC2626" Text="{Binding SafetyAlarmCount}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource KpiStyle}" BorderBrush="#FCD34D">
                <StackPanel><TextBlock Foreground="#92400E" Text="黄色警告" /><TextBlock FontSize="26" FontWeight="Bold" Foreground="#D97706" Text="{Binding WarningCount}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource KpiStyle}" BorderBrush="#93C5FD">
                <StackPanel><TextBlock Foreground="#1D4ED8" Text="应急操作" /><TextBlock FontSize="26" FontWeight="Bold" Foreground="#2563EB" Text="{Binding EmergencyCount}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource KpiStyle}" Width="250">
                <StackPanel><TextBlock Foreground="#475569" Text="最近事件时间" /><TextBlock Margin="0,9,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#172033" Text="{Binding LastEventText}" /></StackPanel>
            </Border>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Margin="0,5,8,0" Foreground="#475569" Text="类型" />
                <ComboBox Width="145" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" />
                <TextBlock Margin="22,5,8,0" Foreground="#475569" Text="来源" />
                <ComboBox Width="125" ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" />
                <TextBlock Margin="22,5,0,0" Foreground="#64748B" Text="此页面只展示事件，不执行清报警、恢复引擎或设备控制。" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource PanelStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredEvents}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Width="160" Binding="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                    <DataGridTextColumn Header="等级" Width="115" Binding="{Binding KindText}" />
                    <DataGridTextColumn Header="来源" Width="150" Binding="{Binding Source}" />
                    <DataGridTextColumn Header="内容" Width="*" Binding="{Binding Message}" />
                    <DataGridTextColumn Header="结果" Width="105" Binding="{Binding ResultText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
