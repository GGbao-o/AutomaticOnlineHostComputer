<Window
    x:Class="AutomaticOnlineHostComputer.Views.Config.ConfigPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="运动参数配置"
    Width="860"
    Height="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="#E8EDF3">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#C6D0DE" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#F7FAFC" />
        <SolidColorBrush x:Key="TextMainBrush" Color="#1F2933" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#5C6675" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1677FF" />
        <SolidColorBrush x:Key="SectionBgBrush" Color="#F8FAFC" />

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="ParamTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="StationLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="56" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="16,12" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Text="运动参数配置" />
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="修改后即时生效，无需重启程序。点击「保存到文件」持久化到 Config/motion_settings.json。" />
            </StackPanel>
        </Border>

        <!-- Tab 区 -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">

            <!-- ══════════ Tab1: 天车速度 ══════════ -->
            <TabItem Header="天车速度">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="5台天车独立速度 (X/Y/Z 三轴，数值为 mm/s)" />
                        <ItemsControl ItemsSource="{Binding CraneSpeedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12,10" Background="{StaticResource SectionBgBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"
                                                       Text="{Binding Label}" Margin="0,0,0,8" />
                                            <!-- X 轴 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="X轴" Width="28" Style="{StaticResource ParamLabelStyle}" />
                                                <TextBlock Text="速度" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding XSpeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="加速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding XAccel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="减速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding XDecel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                            </StackPanel>
                                            <!-- Y 轴 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Y轴" Width="28" Style="{StaticResource ParamLabelStyle}" />
                                                <TextBlock Text="速度" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding YSpeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="加速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding YAccel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="减速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding YDecel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                            </StackPanel>
                                            <!-- Z 轴 -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Z轴" Width="28" Style="{StaticResource ParamLabelStyle}" />
                                                <TextBlock Text="速度" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding ZSpeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="加速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding ZAccel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="减速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding ZDecel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ Tab2: 机械手速度 ══════════ -->
            <TabItem Header="机械手速度">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="3台机械手速度 (仅 Y/Z 两轴)" />
                        <ItemsControl ItemsSource="{Binding ManipulatorSpeedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12,10" Background="{StaticResource SectionBgBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"
                                                       Text="{Binding Label}" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Y轴" Width="28" Style="{StaticResource ParamLabelStyle}" />
                                                <TextBlock Text="速度" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding YSpeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="加速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding YAccel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="减速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding YDecel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Z轴" Width="28" Style="{StaticResource ParamLabelStyle}" />
                                                <TextBlock Text="速度" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding ZSpeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="加速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding ZAccel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                                <TextBlock Text="减速" Style="{StaticResource ColHeaderStyle}" Width="36" />
                                                <TextBox Text="{Binding ZDecel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ Tab3: 斜床参数 ══════════ -->
            <TabItem Header="斜床参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="顶尖距离 &amp; 最大加工长度 (mm)" />

                        <!-- 表头 -->
                        <Border Padding="8,4" Margin="0,0,0,4" Background="{StaticResource HeaderBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="36" Style="{StaticResource ColHeaderStyle}" Text="线体" HorizontalAlignment="Left" />
                                <TextBlock Width="220" Style="{StaticResource ColHeaderStyle}" Text="工位 / 设备" HorizontalAlignment="Left" />
                                <TextBlock Width="90" Style="{StaticResource ColHeaderStyle}" Text="顶尖距离" />
                                <TextBlock Width="90" Style="{StaticResource ColHeaderStyle}" Text="最大长度" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding SkewBedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,2" Padding="8,3" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="36" Text="{Binding LineLabel}" Style="{StaticResource ParamLabelStyle}" />
                                            <TextBlock Width="220" Text="{Binding StationDisplayName}" Style="{StaticResource StationLabelStyle}" />
                                            <TextBox Text="{Binding CenterDistance, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ParamTextBoxStyle}" Width="80" />
                                            <TextBox Text="{Binding MaxWorkpieceLength, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ParamTextBoxStyle}" Width="80" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ Tab4: 机械手坐标 ══════════ -->
            <TabItem Header="机械手坐标">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="机械手2/3 走到各位置的 YZ 坐标 (mm)。值为 0 时走数据库坐标。" />

                        <Border Padding="8,4" Margin="0,0,0,4" Background="{StaticResource HeaderBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="60" Style="{StaticResource ColHeaderStyle}" Text="信号" HorizontalAlignment="Left" />
                                <TextBlock Width="180" Style="{StaticResource ColHeaderStyle}" Text="说明" HorizontalAlignment="Left" />
                                <TextBlock Width="80" Style="{StaticResource ColHeaderStyle}" Text="Y (mm)" />
                                <TextBlock Width="80" Style="{StaticResource ColHeaderStyle}" Text="Z (mm)" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding ArmCoordRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,2" Padding="8,3" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="60" Text="{Binding SignalCode}" Style="{StaticResource StationLabelStyle}" />
                                            <TextBlock Width="180" Text="{Binding Description}" Style="{StaticResource ParamLabelStyle}" />
                                            <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ParamTextBoxStyle}" Width="80" />
                                            <TextBox Text="{Binding Z, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ParamTextBoxStyle}" Width="80" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ Tab5: 编码器标定 ══════════ -->
            <TabItem Header="编码器标定">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="X / Y 绝对编码器标定值 (-1 = 跳过该轴, 不做微调检查)" />

                        <!-- 开关 -->
                        <CheckBox IsChecked="{Binding XAbsFineTuneEnabled}" Margin="0,0,0,10"
                                  Content="启用 X 绝对编码器微调 (Enabled)" FontSize="12" />
                        <CheckBox IsChecked="{Binding YAbsFineTuneEnabled}" Margin="0,0,0,10"
                                  Content="启用 Y 绝对编码器微调 (需现场标定后开启)" FontSize="12" />

                        <TextBlock Text="微调读取验证（所有天车共用）" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="XY到位后等待 (ms):" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding AbsFineTuneBeforeReadSettleDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,14,0" />
                            <TextBlock Text="稳定采样次数:" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding AbsFineTuneStableSampleCount, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,14,0" />
                            <TextBlock Text="采样间隔 (ms):" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding AbsFineTuneStableSampleIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="稳定范围 (mm):" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding AbsFineTuneStableRangeMm, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,14,0" />
                            <TextBlock Text="微调后最短等待 (ms):" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding AbsFineTuneAfterMoveMinSettleDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" />
                        </StackPanel>
                        <TextBlock Margin="0,0,0,10" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Text="修改即时影响后续微调；点击保存后写入配置文件。稳定表示窗口内显示坐标和绝对编码器的最大值减最小值均不超过稳定范围。" />

                        <!-- 通用参数 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="偏差允许 (mm):" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding XAbsToleranceMm, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,14,0" />
                            <TextBlock Text="最大微调量 (mm):" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding XAbsMaxAdjustMm, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,14,0" />
                            <TextBlock Text="Y偏差允许 (mm):" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding YAbsToleranceMm, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,14,0" />
                            <TextBlock Text="Y最大微调量 (mm):" Style="{StaticResource ParamLabelStyle}" />
                            <TextBox Text="{Binding YAbsMaxAdjustMm, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26"
                                     Style="{StaticResource ParamTextBoxStyle}" />
                        </StackPanel>

                        <!-- 天车选择 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="天车:" Style="{StaticResource ParamLabelStyle}" />
                            <ComboBox ItemsSource="{Binding CraneNumbers}" SelectedItem="{Binding SelectedCraneNo}"
                                      Width="60" Height="26" FontSize="12" />
                        </StackPanel>

                        <!-- 工位列表 -->
                        <Border Padding="8,4" Margin="0,0,0,4" Background="{StaticResource HeaderBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Width="210" Style="{StaticResource ColHeaderStyle}" Text="工位 / 设备" HorizontalAlignment="Left" />
                                <TextBlock Width="90" Style="{StaticResource ColHeaderStyle}" Text="编码器X目标" />
                                <TextBlock Width="70" />
                                <TextBlock Width="90" Style="{StaticResource ColHeaderStyle}" Text="编码器Y目标" />
                                <TextBlock Width="70" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding StationTargetRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,2" Padding="8,3" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="210" Text="{Binding StationDisplayName}" Style="{StaticResource StationLabelStyle}" />
                                            <TextBox Text="{Binding TargetX, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ParamTextBoxStyle}" Width="90" />
                                            <Button Width="70" Height="24" FontSize="11" Margin="8,0,0,0"
                                                    Content="读 X"
                                                    Command="{Binding DataContext.ReadCurrentXCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding StationCode}" />
                                            <TextBox Text="{Binding TargetY, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ParamTextBoxStyle}" Width="90" Margin="8,0,0,0" />
                                            <Button Width="70" Height="24" FontSize="11" Margin="8,0,0,0"
                                                    Content="读 Y"
                                                    Command="{Binding DataContext.ReadCurrentYCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding StationCode}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Text="提示：仅1～5号天车使用。天车在线时可读取X(D5014/D5015)或Y(D5020)绝对值；Y默认关闭且全部为-1，完成现场标定并保存后再开启。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════ Tab6: 其他 ══════════ -->
            <TabItem Header="其他">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左列 -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">

                            <!-- 天车归位 -->
                            <Border Padding="12,10" Margin="0,0,0,10" Background="{StaticResource SectionBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="天车归位 X (mm)" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="1号" Width="36" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding Crane1HomeX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                        <TextBlock Text="2号" Width="36" Style="{StaticResource ParamLabelStyle}" Margin="12,0,0,0" />
                                        <TextBox Text="{Binding Crane2HomeX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="3号" Width="36" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding Crane3HomeX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                        <TextBlock Text="4号" Width="36" Style="{StaticResource ParamLabelStyle}" Margin="12,0,0,0" />
                                        <TextBox Text="{Binding Crane4HomeX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="5号" Width="36" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding Crane5HomeX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 机械手安全位 -->
                            <Border Padding="12,10" Margin="0,0,0,10" Background="{StaticResource SectionBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="机械手安全/待机 Y (mm)" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="1线M1释放" Width="76" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding Manipulator1Line1SafeY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="2线M1释放" Width="76" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding Manipulator1Line2SafeY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="M1取板待机" Width="76" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding Manipulator1PickupStandbyY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="M2" Width="36" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding Manipulator2SafeY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="M3" Width="36" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding Manipulator3SafeY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右列 -->
                        <StackPanel Grid.Column="1">
                            <Border Padding="12,10" Margin="0,0,0,10" Background="{StaticResource SectionBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="研磨 &amp; 动平衡" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="后天车安全X" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding RearCraneSafeX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" Width="80" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="研磨Z安全高度" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding GrindingSafeZ, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" Width="80" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="研磨天车编号" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding GrindingCraneNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" Width="50" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="工件显示屏 IP" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding GrindingWorkpieceDisplayIp, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ParamTextBoxStyle}" Width="130" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"
                                               Text="Modbus TCP：端口502、站号1；直径地址100，长度地址101。显示失败不影响研磨流程。" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="充磁后X11稳定等待" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding X11StableDelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" Width="80" />
                                        <TextBlock Text="ms" Style="{StaticResource ParamLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"
                                               Text="全线共用：前/后天车、机械手、动平衡和研磨天车每次充磁后，等待该时长再读取X11有板信号。" />
                                </StackPanel>
                            </Border>

                            <Border Padding="12,10" Margin="0,0,0,10" Background="{StaticResource SectionBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="研磨状态超时（分钟）" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"
                                               Text="对应状态超过设定时间会暂停研磨引擎，并保留现场工件和状态等待人工确认。" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="上料中 Loading" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding GrindingLoadingTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" Width="55" />
                                        <TextBlock Text="分钟" Style="{StaticResource ParamLabelStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="等待下料" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding GrindingWaitingForUnloadTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" Width="55" />
                                        <TextBlock Text="分钟" Style="{StaticResource ParamLabelStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="下料中 Unloading" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding GrindingUnloadingTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" Width="55" />
                                        <TextBlock Text="分钟" Style="{StaticResource ParamLabelStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Padding="12,10" Margin="0,0,0,10" Background="{StaticResource SectionBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="X2下压正常到位" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"
                                               Text="Z下降时X2亮后，先急停并读取停止位置；与目标Z误差在此范围内则恢复伺服并继续流程，超出范围才暂停。" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="允许误差" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding PressureStopNormalPositionToleranceMm, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ParamTextBoxStyle}" Width="60" />
                                        <TextBlock Text="mm" Style="{StaticResource ParamLabelStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Padding="12,10" Margin="0,0,0,10" Background="{StaticResource SectionBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Y轴偏移 (mm)" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="大孔(100)" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding LargeBoreOffset, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="小孔(70)" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Text="{Binding SmallBoreOffset, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBoxStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Padding="12,10" Margin="0,0,0,10" Background="{StaticResource SectionBgBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="直径补偿 (mm)" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"
                                               Text="下发给CNC的直径 = ERP原始直径 + 此偏移。不参与Z下降计算。" />
                                    <ItemsControl ItemsSource="{Binding DiameterOffsetRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Width="62" Text="{Binding StationCode}" Style="{StaticResource StationLabelStyle}" />
                                                    <TextBlock Width="110" Text="{Binding StationName}" Style="{StaticResource ParamLabelStyle}" />
                                                    <!-- 小数输入必须在编辑完成后提交；逐字符回写会把中间态“1.”格式化为“1”，随后输入5就变成15。 -->
                                                    <TextBox Text="{Binding OffsetMm, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"
                                                             Style="{StaticResource ParamTextBoxStyle}" Width="60" />
                                                    <TextBlock Text="mm" Style="{StaticResource ParamLabelStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="14,10" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="修改即时生效。保存持久化到 JSON，下次启动自动加载。" />
                <Button Content="保存到文件" Style="{StaticResource SaveButtonStyle}" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
