<Window x:Class="AutomaticOnlineHostComputer.Views.Home.Dialogs.SafetyAlarmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Sections.Title}" Width="860" Height="860" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F4F7FB" FontFamily="Microsoft YaHei UI"
        FontSize="14" Foreground="#1E293B" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Detail" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22" Background="#F4F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding Sections.Title}" Foreground="#BE123C" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="引擎已暂停 · 请结合实物确认现场，再按原流程处置" Foreground="#9F1239" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="异常原因与执行步骤"/>
                    <TextBox Style="{StaticResource Detail}" Text="{Binding Sections.Failure, Mode=OneWay}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="工件信息与搬运流向"/>
                    <TextBox Style="{StaticResource Detail}" Text="{Binding Sections.Workpiece, Mode=OneWay}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="故障时记录（已保存，不随刷新改变）"/>
                    <TextBox Style="{StaticResource Detail}" Text="{Binding Sections.Historical, Mode=OneWay}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="现场状态（异常后只读采样）"/>
                    <TextBox Style="{StaticResource Detail}" Text="{Binding Sections.Live, Mode=OneWay}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="最终收尾与处置说明"/>
                    <TextBox Style="{StaticResource Detail}" Text="{Binding Sections.Cleanup, Mode=OneWay}"/>
                </StackPanel></Border>
                <Expander Header="查看完整异常信息" Margin="8,0,0,14">
                    <TextBox Style="{StaticResource Detail}" Text="{Binding Sections.ExceptionDetail, Mode=OneWay}" Margin="0,10,0,0"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="刷新现场状态" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click"/>
                <Button Content="复制详情" Click="Copy_Click"/>
                <Button Content="关闭" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
            <TextBlock Text="{Binding RefreshStatus}" VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
