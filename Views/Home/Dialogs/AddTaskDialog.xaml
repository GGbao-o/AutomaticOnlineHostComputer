<Window
    x:Class="AutomaticOnlineHostComputer.Views.Home.Dialogs.AddTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="新增工件任务"
    Width="420"
    Height="700"
    Background="{StaticResource AppBackgroundBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="12"
            Background="#26323F"
            BorderBrush="#26323F"
            BorderThickness="1"
            CornerRadius="6">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Text="新增工件任务" />
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,6" VerticalAlignment="Center" Text="版号" />
            <TextBox Grid.Column="1" Margin="0,6"
                     Text="{Binding PlateNo, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="1" Margin="0,6" VerticalAlignment="Center" Text="序号" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6"
                     Text="{Binding Sequence, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="2" Margin="0,6" VerticalAlignment="Center" Text="版长" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6"
                     Text="{Binding Length, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="3" Margin="0,6" VerticalAlignment="Center" Text="直径" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6"
                     Text="{Binding Diameter, UpdateSourceTrigger=LostFocus}" />

            <!-- 堵孔：70=小孔，100=大孔 -->
            <TextBlock Grid.Row="4" Margin="0,6" VerticalAlignment="Center" Text="堵孔" />
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,6"
                      ItemsSource="{Binding PlugHoleOptions}"
                      SelectedItem="{Binding PlugHole, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="5" Margin="0,6" VerticalAlignment="Center" Text="左堵厚" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,6"
                     Text="{Binding LeftPlugThickness, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="6" Margin="0,6" VerticalAlignment="Center" Text="右堵厚" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,6"
                     Text="{Binding RightPlugThickness, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="7" Margin="0,6" VerticalAlignment="Center" Text="刻印内容" />
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,6"
                     Text="{Binding MarkingContent, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="8" Margin="0,6" VerticalAlignment="Center" Text="工序" />
            <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,6"
                      ItemsSource="{Binding ProcessTypeOptions}"
                      SelectedItem="{Binding ProcessType, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

            <!-- 新增：镗孔工艺（传给双头镗） -->
            <TextBlock Grid.Row="9" Margin="0,6" VerticalAlignment="Center" Text="镗孔工艺" />
            <TextBox Grid.Row="9" Grid.Column="1" Margin="0,6"
                     Text="{Binding BoringProcess, UpdateSourceTrigger=LostFocus}" />

            <!-- 新增：斜床工艺（传给斜床） -->
            <TextBlock Grid.Row="10" Margin="0,6" VerticalAlignment="Center" Text="斜床工艺" />
            <ComboBox Grid.Row="10" Grid.Column="1" Margin="0,6"
                      ItemsSource="{Binding SkewBedProcessOptions}"
                      SelectedItem="{Binding SkewBedProcess, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 勾选后不改变线路分配, 只让斜床下料时强制走动平衡下料架(M817/M818)。 -->
            <CheckBox Grid.Row="11" Grid.ColumnSpan="2" Margin="0,10,0,4"
                      Content="是否做动平衡"
                      IsChecked="{Binding ForceBalancing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 人工把板放到中转架时使用: 只写后端工件缓存, 不写PLC有板信号。 -->
            <CheckBox Grid.Row="12" Grid.ColumnSpan="2" Margin="0,8,0,4"
                      Content="从中转架开始"
                      IsChecked="{Binding IsStartFromTransferRack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="13" Margin="0,6" VerticalAlignment="Center" Text="中转架">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStartFromTransferRack}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ComboBox Grid.Row="13" Grid.Column="1" Margin="0,6"
                      ItemsSource="{Binding TransferRackOptions}"
                      SelectedItem="{Binding SelectedTransferRack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStartFromTransferRack}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="84" Height="32" Margin="0,0,8,0"
                    Click="Ok_Click" Content="确定" />
            <Button Width="84" Height="32"
                    Click="Cancel_Click" Content="取消" />
        </StackPanel>
    </Grid>
</Window>
