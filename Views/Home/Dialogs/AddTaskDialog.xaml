<Window x:Class="AutomaticOnlineHostComputer.Views.Home.Dialogs.AddTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增工件任务"
        Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F0F2F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1" CornerRadius="6">
            <TextBlock Text="新增工件任务" FontSize="18" FontWeight="Bold" />
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="版号" Margin="0,6" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Margin="0,6" Text="{Binding PlateNo, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Text="序号" Margin="0,6" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6" Text="{Binding Sequence, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Text="版长" Margin="0,6" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Text="直径" Margin="0,6" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" Text="{Binding Diameter, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Text="堵孔" Margin="0,6" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6" Text="{Binding PlugHole, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5" Text="左堵厚" Margin="0,6" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,6" Text="{Binding LeftPlugThickness, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6" Text="右堵厚" Margin="0,6" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,6" Text="{Binding RightPlugThickness, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="7" Text="刻印内容" Margin="0,6" VerticalAlignment="Center"/>
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,6" Text="{Binding MarkingContent, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="8" Text="工序" Margin="0,6" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,6"
                      ItemsSource="{Binding ProcessTypeOptions}"
                      SelectedItem="{Binding ProcessType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="84" Height="32" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="取消" Width="84" Height="32" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
