<Window x:Class="AutomaticOnlineHostComputer.Views.Home.Dialogs.RouteSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="线路选取" Width="300" Height="180"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F0F2F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="分配线路（400~1200mm 范围可选）" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" />

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="RadioLine1" Content="1号线（400~1500mm）" IsChecked="True" Margin="0,0,0,8" FontSize="13" />
            <RadioButton x:Name="RadioLine2" Content="2号线（400~1200mm）" FontSize="13" />
            <TextBlock Text="1200~1500mm 强制走 1 号线" FontSize="11" Foreground="Gray" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="确定" Width="80" Height="28" Click="Confirm_Click" Margin="0,0,10,0" />
            <Button Content="取消" Width="80" Height="28" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
