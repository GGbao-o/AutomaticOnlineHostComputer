<Window x:Class="AutomaticOnlineHostComputer.Views.Home.Dialogs.RouteSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="线路选取"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F0F2F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="10" Background="White" BorderBrush="#C8D1DE" BorderThickness="1">
            <TextBlock Text="线路选取" FontSize="18" FontWeight="Bold" />
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="工件长度：" FontSize="14" Margin="0,0,0,10" />

                <GroupBox Header="一号线" Margin="0,0,0,10" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBox Width="70" Text="400" Margin="0,0,8,0" />
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="1200" Margin="0,0,8,0" />
                            <TextBlock Text="mm" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <RadioButton IsChecked="True" Margin="0,0,8,0" />
                            <TextBlock Text="上料架与双头镗直接交互" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="1000" Margin="0,0,8,0" />
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="1200" Margin="0,0,8,0" />
                            <TextBlock Text="mm" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton IsChecked="True" Margin="0,0,8,0" />
                            <TextBlock Text="天车夹取" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="400" Margin="0,0,8,0" />
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="1000" Margin="0,0,8,0" />
                            <TextBlock Text="mm" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="二号线" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBox Width="70" Text="400" Margin="0,0,8,0" />
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="1500" Margin="0,0,8,0" />
                            <TextBlock Text="mm" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <RadioButton IsChecked="True" Margin="0,0,8,0" />
                            <TextBlock Text="上料架与双头镗直接交互" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="1300" Margin="0,0,8,0" />
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="1500" Margin="0,0,8,0" />
                            <TextBlock Text="mm" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton IsChecked="True" Margin="0,0,8,0" />
                            <TextBlock Text="天车夹取" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="400" Margin="0,0,8,0" />
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="1300" Margin="0,0,8,0" />
                            <TextBlock Text="mm" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="确定" Width="90" Height="30" Margin="0,0,12,0" />
            <Button Content="取消" Width="90" Height="30" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>