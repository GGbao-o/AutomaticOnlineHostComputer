<Window
    x:Class="AutomaticOnlineHostComputer.Views.Home.Dialogs.ClearMachineStatusDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="清空机器状态"
    Width="690"
    Height="720"
    Background="{StaticResource AppBackgroundBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="12"
            Background="#26323F"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="清空机器状态" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="#FFFBBF24"
                    Text="每次只清所选设备中由上位机写入的数据。请先停止或暂停对应引擎，并确认设备没有正在执行的动作。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  按钮区 + 日志  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  双头镗  -->
            <GroupBox
                Grid.Row="0"
                Margin="0,0,0,6"
                Padding="8"
                Header="双头镗 (Syntec R区)">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnBoring1"
                        Width="140"
                        Height="28"
                        Margin="0,0,8,0"
                        Click="BtnBoring1_Click"
                        Content="清空 1号线 ST103" />
                    <Button
                        x:Name="BtnBoring2"
                        Width="140"
                        Height="28"
                        Click="BtnBoring2_Click"
                        Content="清空 2号线 ST402" />
                </StackPanel>
            </GroupBox>

            <!--  斜床  -->
            <GroupBox
                Grid.Row="1"
                Margin="0,0,0,6"
                Padding="8"
                Header="斜床 (锦州 Modbus / FANUC FOCAS)">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="1号线斜床（点哪个只清哪个）" />
                    <UniformGrid Margin="0,0,0,8" Columns="5">
                        <!--  1号线物理顺序不是站号数字顺序：ST111是3号斜床，ST110是4号斜床。  -->
                        <Button Margin="2" Height="30" Tag="ST108" Click="SkewButton_Click" Content="1号斜床 ST108" />
                        <Button Margin="2" Height="30" Tag="ST109" Click="SkewButton_Click" Content="2号斜床 ST109" />
                        <Button Margin="2" Height="30" Tag="ST111" Click="SkewButton_Click" Content="3号斜床 ST111" />
                        <Button Margin="2" Height="30" Tag="ST110" Click="SkewButton_Click" Content="4号斜床 ST110" />
                        <Button Margin="2" Height="30" Tag="ST112" Click="SkewButton_Click" Content="5号斜床 ST112" />
                    </UniformGrid>

                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="2号线斜床（点哪个只清哪个）" />
                    <UniformGrid Columns="5">
                        <Button Margin="2" Height="30" Tag="ST606" Click="SkewButton_Click" Content="清 ST606" />
                        <Button Margin="2" Height="30" Tag="ST607" Click="SkewButton_Click" Content="清 ST607" />
                        <Button Margin="2" Height="30" Tag="ST608" Click="SkewButton_Click" Content="清 ST608" />
                        <Button Margin="2" Height="30" Tag="ST609" Click="SkewButton_Click" Content="清 ST609" />
                        <Button Margin="2" Height="30" Tag="ST610" Click="SkewButton_Click" Content="清 ST610" />
                    </UniformGrid>
                </StackPanel>
            </GroupBox>

            <!--  研磨机  -->
            <GroupBox
                Grid.Row="2"
                Margin="0,0,0,6"
                Padding="8"
                Header="研磨机 (Modbus TCP)">
                <UniformGrid Columns="4">
                    <Button Margin="2" Height="30" Tag="ST701" Click="GrinderButton_Click" Content="清 ST701（新代）" />
                    <Button Margin="2" Height="30" Tag="ST702" Click="GrinderButton_Click" Content="清 ST702（新代）" />
                    <Button Margin="2" Height="30" Tag="ST703" Click="GrinderButton_Click" Content="清 ST703（西门子）" />
                    <Button Margin="2" Height="30" Tag="ST704" Click="GrinderButton_Click" Content="清 ST704（西门子）" />
                </UniformGrid>
            </GroupBox>

            <!--  日志  -->
            <GroupBox
                Grid.Row="3"
                Margin="0,8,0,0"
                Padding="5"
                Header="操作日志">
                <RichTextBox
                    x:Name="TxtLog"
                    Height="160"
                    Background="White"
                    FontFamily="Consolas"
                    FontSize="11"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>

        <!--  底部按钮  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Height="28"
                Click="BtnClose_Click"
                Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
