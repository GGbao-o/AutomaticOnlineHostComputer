<Window
    x:Class="AutomaticOnlineHostComputer.Views.Home.Dialogs.CraneMoveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="天车X轴移动"
    Width="460"
    Height="600"
    Background="{StaticResource AppBackgroundBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="12"
            Background="#26323F"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="天车 X 轴移动" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="#FFFBBF24"
                    Text="仅移动 X 轴，Y/Z 保持当前位置不动。请确认天车空闲后再操作。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  天车选择  -->
            <GroupBox
                Grid.Row="0"
                Margin="0,0,0,6"
                Padding="8"
                Header="选择天车">
                <ComboBox
                    x:Name="CmbCrane"
                    Height="28"
                    FontSize="13"
                    SelectionChanged="CmbCrane_SelectionChanged" />
            </GroupBox>

            <!--  目标工位选择  -->
            <GroupBox
                Grid.Row="1"
                Margin="0,0,0,6"
                Padding="8"
                Header="目标工位">
                <ComboBox
                    x:Name="CmbStation"
                    Height="28"
                    FontSize="13"
                    SelectionChanged="CmbStation_SelectionChanged" />
            </GroupBox>

            <!--  位置信息  -->
            <GroupBox
                Grid.Row="2"
                Margin="0,0,0,6"
                Padding="8"
                Header="移动信息">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="Bold"
                        Text="── 当前位置 ──" />
                    <TextBlock
                        x:Name="TxtCurrent"
                        Margin="0,0,0,8"
                        FontFamily="Consolas"
                        FontSize="13"
                        Text="点击「刷新位置」读取" />
                    <Button
                        x:Name="BtnRefresh"
                        Width="110"
                        Height="26"
                        Margin="0,0,0,10"
                        Click="BtnRefresh_Click"
                        Content="刷新当前位置" />

                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="Bold"
                        Text="── 目标 ──" />
                    <TextBlock
                        x:Name="TxtTarget"
                        Margin="0,0,0,4"
                        FontFamily="Consolas"
                        FontSize="13"
                        Text="请先选择天车和工位" />
                    <TextBlock
                        FontSize="11"
                        Foreground="Gray"
                        Text="YZ 保持不动" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="BtnMove"
                Width="120"
                Height="32"
                Margin="0,0,12,0"
                Click="BtnMove_Click"
                Content="确认移动 X 轴"
                FontWeight="Bold"
                IsEnabled="False" />
            <Button
                Width="80"
                Height="28"
                Click="BtnClose_Click"
                Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
