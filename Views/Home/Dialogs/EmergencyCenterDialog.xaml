<Window
    x:Class="AutomaticOnlineHostComputer.Views.Home.Dialogs.EmergencyCenterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="应急处理中心"
    Width="900"
    Height="680"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="应急处理中心" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="#B91C1C"
                TextWrapping="Wrap"
                Text="用于现场故障后的人工介入：请先人工确认磁铁、工件、天车/机械手已经处理到安全状态，再清设备参数、上位机缓存和明确持有的软件锁。" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="前端在途应急">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="线体" />
                        <ComboBox x:Name="FrontLineBox" Width="120" SelectionChanged="Front_SelectionChanged">
                            <ComboBoxItem Content="1号线" Tag="1" IsSelected="True" />
                            <ComboBoxItem Content="2号线" Tag="2" />
                        </ComboBox>
                        <Button Margin="18,0,0,0" Width="100" Content="刷新实时诊断" Click="RefreshFront_Click" />
                    </WrapPanel>
                    <TextBox
                        x:Name="FrontInfoBox"
                        Grid.Row="1"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="正在读取实时诊断..."
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        AcceptsReturn="True" />
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="ContinueFrontButton"
                            Width="230"
                            Margin="0,0,10,0"
                            Content="板已在货叉，确认安全后继续"
                            Click="ContinueFront_Click" />
                        <Button
                            x:Name="DiscardFrontButton"
                            Width="200"
                            Content="丢弃当前工件并回Idle"
                            Click="DiscardFront_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="斜床应急">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="线体" />
                        <ComboBox x:Name="SkewLineBox" Width="120" SelectionChanged="Skew_SelectionChanged">
                            <ComboBoxItem Content="1号线" Tag="1" IsSelected="True" />
                            <ComboBoxItem Content="2号线" Tag="2" />
                        </ComboBox>
                        <TextBlock Margin="18,0,8,0" VerticalAlignment="Center" Text="斜床" />
                        <ComboBox x:Name="SkewBedBox" Width="150" SelectionChanged="Skew_SelectionChanged" />
                        <Button Margin="18,0,0,0" Width="90" Content="刷新诊断" Click="RefreshSkew_Click" />
                    </WrapPanel>
                    <TextBox
                        x:Name="SkewInfoBox"
                        Grid.Row="1"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        AcceptsReturn="True" />
                    <Button
                        x:Name="ClearSkewButton"
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Width="150"
                        Content="执行斜床应急"
                        Click="ClearSkew_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="动平衡应急">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="位置" />
                        <ComboBox x:Name="BalancePositionBox" Width="240" SelectionChanged="Balance_SelectionChanged">
                            <ComboBoxItem Content="M817 - 1号线动平衡下料架1" Tag="M817" IsSelected="True" />
                            <ComboBoxItem Content="M818 - 2号线动平衡下料架1" Tag="M818" />
                            <ComboBoxItem Content="M821 - 2号线短板中转位" Tag="M821" />
                            <ComboBoxItem Content="M720 - 研磨上料架1号位" Tag="M720" />
                            <ComboBoxItem Content="M710 - 动平衡料架1" Tag="M710" />
                            <ComboBoxItem Content="M700 - 动平衡料架2" Tag="M700" />
                        </ComboBox>
                        <Button Margin="18,0,0,0" Width="90" Content="刷新诊断" Click="RefreshBalance_Click" />
                    </WrapPanel>
                    <TextBox
                        x:Name="BalanceInfoBox"
                        Grid.Row="1"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        AcceptsReturn="True" />
                    <Button
                        x:Name="ClearBalanceButton"
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Width="170"
                        Content="执行动平衡应急"
                        Click="ClearBalance_Click" />
                </Grid>
            </TabItem>

            <TabItem Header="研磨机应急">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="目标" />
                        <ComboBox x:Name="GrindingTargetBox" Width="240" SelectionChanged="Grinding_SelectionChanged">
                            <ComboBoxItem Content="ST709 - 研磨上料架3号位FIFO队头" Tag="ST709" IsSelected="True" />
                            <ComboBoxItem Content="ST701 - 研磨机1(新代)" Tag="ST701" />
                            <ComboBoxItem Content="ST702 - 研磨机2(新代)" Tag="ST702" />
                            <ComboBoxItem Content="ST703 - 研磨机3(西门子)" Tag="ST703" />
                            <ComboBoxItem Content="ST704 - 研磨机4(西门子)" Tag="ST704" />
                        </ComboBox>
                        <Button Margin="18,0,0,0" Width="90" Content="刷新诊断" Click="RefreshGrinding_Click" />
                    </WrapPanel>
                    <TextBox
                        x:Name="GrindingInfoBox"
                        Grid.Row="1"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        AcceptsReturn="True" />
                    <Button
                        x:Name="ClearGrindingButton"
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Width="160"
                        Content="执行研磨应急"
                        Click="ClearGrinding_Click" />
                </Grid>
            </TabItem>
        </TabControl>

        <Button
            Grid.Row="2"
            Margin="0,14,0,0"
            Width="90"
            HorizontalAlignment="Right"
            Content="关闭"
            Click="Close_Click" />
    </Grid>
</Window>
