<UserControl x:Class="AutomaticOnlineHostComputer.Views.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="4,0,4,2" BorderBrush="#F59E0B" BorderThickness="1"
                Background="#FFF7ED" Padding="6,4">
            <DockPanel>
                <TextBlock Text="" DockPanel.Dock="Left" />
                <Button Content="线路选取"
                        DockPanel.Dock="Right"
                        Width="96"
                        Height="28"
                        Margin="0,0,2,0"
                        Click="RouteSelect_Click" />
            </DockPanel>
        </Border>

        <!-- 1: 任务列表 -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="6">
                    <Button Content="添加任务" Width="84" Height="30" Margin="2" Click="AddTask_Click" />
                    <Button Content="启动一号线" Width="90" Height="30" Margin="2" />
                    <Button Content="启动二号线" Width="90" Height="30" Margin="2" />
                    <Button Content="启动研磨" Width="84" Height="30" Margin="2" />
                </StackPanel>
                <DataGrid Grid.Row="1" Margin="6"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="*" />
                        <DataGridTextColumn Header="当前工序" Binding="{Binding Step}" Width="*" />
                        <DataGridTextColumn Header="工件状态" Binding="{Binding State}" Width="*" />
                        <DataGridTextColumn Header="交互" Binding="{Binding Action}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 2: 操作控制区（必须滚动） -->
        <Border Grid.Row="1" Grid.Column="1" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid MinWidth="320" MinHeight="560" Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="选择天车" Margin="4" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Margin="4" MinWidth="120">
                        <ComboBoxItem Content="1号天车" />
                        <ComboBoxItem Content="2号天车" />
                    </ComboBox>

                    <CheckBox Grid.Column="2" Content="自动控制" Margin="4" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Text="单次运动距离" Margin="4" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4" Text="1000" />
                    <CheckBox Grid.Row="1" Grid.Column="2" Content="手动控制" Margin="4" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Text="工件长度" Margin="4" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="4" />

                    <UniformGrid Grid.Row="3" Grid.ColumnSpan="3" Columns="4" Margin="2">
                        <Button Content="X+" Margin="2" Height="32" />
                        <Button Content="X-" Margin="2" Height="32" />
                        <Button Content="停止运动" Margin="2" Height="32" />
                        <Button Content="回原点" Margin="2" Height="32" />
                        <Button Content="Y+" Margin="2" Height="32" />
                        <Button Content="Y-" Margin="2" Height="32" />
                        <Button Content="编码器归零" Margin="2" Height="32" />
                        <Button Content="回零停止" Margin="2" Height="32" />
                        <Button Content="Z+" Margin="2" Height="32" />
                        <Button Content="Z-" Margin="2" Height="32" />
                        <Button Content="磁铁吸合" Margin="2" Height="32" />
                        <Button Content="磁铁释放" Margin="2" Height="32" />
                        <Button Content="急停恢复" Margin="2" Height="32" />
                        <Button Content="清除故障" Margin="2" Height="32" />
                        <Button Content="接触器打开" Margin="2" Height="32" />
                        <Button Content="接触器关闭" Margin="2" Height="32" />
                    </UniformGrid>

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="激光测距: -1" Margin="6,10,6,0" FontWeight="Bold" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 3: 天车和机械手黄台（必须滚动） -->
        <Border Grid.Row="1" Grid.Column="2" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1"
                Background="#FFFDF4D6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6" MinWidth="1400" MinHeight="560">
                    <TextBlock Text="天车 / 机械手 黄台总览" FontSize="16" FontWeight="Bold" Margin="2,2,2,8" />

                    <UniformGrid Columns="5" Margin="0,0,0,8">
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6">
                            <TextBlock Text="1-天车" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6">
                            <TextBlock Text="2-天车" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6">
                            <TextBlock Text="3-天车" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6">
                            <TextBlock Text="4-天车" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6">
                            <TextBlock Text="5-天车" HorizontalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="5" Margin="0,0,0,8">
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6">
                            <TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6">
                            <TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6">
                            <TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6">
                            <TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6">
                            <TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6">
                            <TextBlock Text="1-机械手" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6">
                            <TextBlock Text="2-机械手" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6">
                            <TextBlock Text="3-机械手" HorizontalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,0,0,4">
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6">
                            <TextBlock Text="急停Y/驱动Y/正极Y/..." Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6">
                            <TextBlock Text="急停Y/驱动Y/正极Y/..." Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                        <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6">
                            <TextBlock Text="急停Y/驱动Y/正极Y/..." Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 4: 全厂下位机 / 流程图机器状态（必须滚动） -->
        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1"
                Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6" MinWidth="2800" MinHeight="520">
                    <TextBlock Text="全厂下位机状态 / 全流程机器状态图" FontSize="16" FontWeight="Bold" Margin="2,2,2,10" />

                    <!-- ========== 第0行：左侧设备 + 上方主要流程线 ========== -->
                    <StackPanel Orientation="Horizontal">

                        <!-- 01总上料架 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="01总上料架" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_01, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_01, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 02机械手1 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="02机械手1" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_02, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_02, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 间距 -->
                        <Border Width="20" Background="Transparent" />

                        <!-- 11货叉1(上料架1) -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="11货叉1(上料架1)" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_11, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_11, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 18一号双头镗 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="18一号双头镗" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_18, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_18, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 19一号打号机 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="19一号打号机" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_19, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_19, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 03中转站1 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="03中转站1" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_03_1, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_03_1, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 03中转站2 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="03中转站2" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_03_2, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_03_2, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 03中转站3 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="03中转站3" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_03_3, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_03_3, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 20一号斜床 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="20一号斜床" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_20, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_20, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 21二号斜床 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="21二号斜床" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_21, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_21, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 22三号斜床 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="22三号斜床" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_22, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_22, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 23四号斜床 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="23四号斜床" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_23, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_23, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 24五号斜床 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="24五号斜床" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
                                <Border Grid.Row="1" Background="#D6E4F0" Margin="4,2,4,1" Padding="2">
                                    <TextBlock Text="{Binding Status1_24, FallbackValue=未知}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                                <Border Grid.Row="2" Background="#D6E4F0" Margin="4,1,4,4" Padding="2">
                                    <TextBlock Text="{Binding Status2_24, FallbackValue=无}"
                                               HorizontalAlignment="Center" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 13下料架1 -->
                        <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1"
                                Background="#EEF3F8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="13下料架1" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,6,0,0" />
