<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.Home.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AutomaticOnlineHostComputer.Views.Home.Controls"
    Background="#F0F2F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Margin="4,0,4,2"
            Padding="6,4"
            Background="#FFF7ED"
            BorderBrush="#F59E0B"
            BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Width="96"
                    Height="28"
                    Margin="0,0,2,0"
                    Click="RouteSelect_Click"
                    Content="线路选取" />
                <Button
                    Width="84"
                    Height="28"
                    Margin="2"
                    Click="ClearMachineStatus_Click"
                    Content="清空状态" />
                <Button
                    Width="96"
                    Height="28"
                    Margin="2"
                    Click="CraneMove_Click"
                    Content="天车移动" />
                <Button
                    Width="90"
                    Height="28"
                    Margin="2"
                    Command="{Binding Line1ToggleCommand}"
                    Content="{Binding Line1ToggleText}" />
                <Button
                    Width="90"
                    Height="28"
                    Margin="2"
                    Command="{Binding Line2ToggleCommand}"
                    Content="{Binding Line2ToggleText}" />
                <Button
                    Width="84"
                    Height="28"
                    Margin="2"
                    Command="{Binding GrindingToggleCommand}"
                    Content="{Binding GrindingToggleText}" />
                <Button
                    Width="84"
                    Height="28"
                    Margin="2"
                    Command="{Binding BalancingToggleCommand}"
                    Content="{Binding BalancingToggleText}" />
            </StackPanel>
        </Border>
        <!--  第一部分  -->
        <Border
            Grid.Row="1"
            Margin="4"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6" Orientation="Horizontal">
                        <Button
                            Width="84"
                            Height="30"
                            Margin="2"
                            Click="AddTask_Click"
                            Content="添加任务" />

                        <!--<Button
                            Width="70"
                            Height="30"
                            Margin="2"
                            Command="{Binding TestRearPickupCommand}"
                            Content="测试1号线后天车取料" />

                        <Button
                            Width="70"
                            Height="30"
                            Margin="2"
                            Command="{Binding TestRearPickup2Command}"
                            Content="测试2号线后天车取料" />-->

                        <Separator Width="8" />

                        <!--<TextBlock
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Text="直径:" />
                        <TextBox
                            Width="50"
                            Height="28"
                            Margin="2"
                            Text="{Binding BalancingTestDiameter}" />

                        <TextBlock
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Text="版长:" />
                        <TextBox
                            Width="50"
                            Height="28"
                            Margin="2"
                            Text="{Binding BalancingTestLength}" />

                        <TextBlock
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Text="位置:" />
                        <ComboBox
                            Width="70"
                            Height="28"
                            Margin="2"
                            ItemsSource="{Binding BalancingPositions}"
                            SelectedItem="{Binding SelectedBalancingPosition}" />

                        <Button
                            Width="80"
                            Height="30"
                            Margin="2"
                            Command="{Binding TestBalancingRackPlacedCommand}"
                            Content="测试动平衡" />-->
                    </StackPanel>
                </ScrollViewer>

                <!--  添加任务数据位置  -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid
                        Margin="6"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding TaskRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding PlateNo}"
                                Header="版号" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Sequence}"
                                Header="序号" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Length}"
                                Header="版长" />
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding Diameter}"
                                Header="直径" />
                            <!--  <DataGridTextColumn  -->
                            <!--  Width="70"  -->
                            <!--  Binding="{Binding PlugHole}"  -->
                            <!--  Header="堵孔" />  -->
                            <!--  <DataGridTextColumn  -->
                            <!--  Width="70"  -->
                            <!--  Binding="{Binding LeftPlugThickness}"  -->
                            <!--  Header="左堵厚" />  -->
                            <!--  <DataGridTextColumn  -->
                            <!--  Width="70"  -->
                            <!--  Binding="{Binding RightPlugThickness}"  -->
                            <!--  Header="右堵厚" />  -->
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding StartSourceText}"
                                Header="任务起点" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding AssignedLineText}"
                                Header="分配线路" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding Step}"
                                Header="当前工序" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding ProcessType}"
                                Header="工序" />
                            <!--  <DataGridTextColumn  -->
                            <!--  Width="120"  -->
                            <!--  Binding="{Binding BoringProcess}"  -->
                            <!--  Header="双头镗工艺" />  -->
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding SkewBedProcess}"
                                Header="斜床工艺" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding MarkingContent}"
                                Header="打号内容" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding State}"
                                Header="工件状态" />
                            <DataGridTemplateColumn Width="70" Header="交互">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Height="26"
                                            Margin="2"
                                            Command="{Binding ToggleRunCommand}"
                                            Content="{Binding ActionText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Grid>
        </Border>
        <!--  启动加载遮罩：LoadAsync完成前覆盖整个页面  -->
        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="99"
            Background="#CCF0F2F5"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Text="⏳" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="正在加载设备数据..." />
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#888"
                    Text="连接天车 · 机械手 · 全厂设备" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
