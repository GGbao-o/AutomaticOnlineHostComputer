<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.Home.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AutomaticOnlineHostComputer.Views.Home.Controls"
    Background="#F0F2F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="4,0,4,2"
            Padding="6,4"
            Background="#FFF7ED"
            BorderBrush="#F59E0B"
            BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Width="96"
                    Height="28"
                    Margin="0,0,2,0"
                    Click="RouteSelect_Click"
                    Content="线路选取" />
                <Button
                    Width="84"
                    Height="28"
                    Margin="2"
                    Click="ClearMachineStatus_Click"
                    Content="清空状态" />
                <Button
                    Width="96"
                    Height="28"
                    Margin="2"
                    Click="CraneMove_Click"
                    Content="天车移动" />
                <Button
                    Width="90"
                    Height="28"
                    Margin="2"
                    Command="{Binding Line1ToggleCommand}"
                    Content="{Binding Line1ToggleText}" />
                <Button
                    Width="90"
                    Height="28"
                    Margin="2"
                    Command="{Binding Line2ToggleCommand}"
                    Content="{Binding Line2ToggleText}" />
                <Button
                    Width="84"
                    Height="28"
                    Margin="2"
                    Command="{Binding GrindingToggleCommand}"
                    Content="{Binding GrindingToggleText}" />
                <Button
                    Width="84"
                    Height="28"
                    Margin="2"
                    Command="{Binding BalancingToggleCommand}"
                    Content="{Binding BalancingToggleText}" />
            </StackPanel>
        </Border>
        <!--  第一部分  -->
        <Border
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            Margin="4"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6" Orientation="Horizontal">
                        <Button
                            Width="84"
                            Height="30"
                            Margin="2"
                            Click="AddTask_Click"
                            Content="添加任务" />

                        <!--<Button
                            Width="70"
                            Height="30"
                            Margin="2"
                            Command="{Binding TestRearPickupCommand}"
                            Content="测试1号线后天车取料" />

                        <Button
                            Width="70"
                            Height="30"
                            Margin="2"
                            Command="{Binding TestRearPickup2Command}"
                            Content="测试2号线后天车取料" />-->

                        <Separator Width="8" />

                        <TextBlock
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Text="直径:" />
                        <TextBox
                            Width="50"
                            Height="28"
                            Margin="2"
                            Text="{Binding BalancingTestDiameter}" />

                        <TextBlock
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Text="版长:" />
                        <TextBox
                            Width="50"
                            Height="28"
                            Margin="2"
                            Text="{Binding BalancingTestLength}" />

                        <TextBlock
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Text="位置:" />
                        <ComboBox
                            Width="70"
                            Height="28"
                            Margin="2"
                            ItemsSource="{Binding BalancingPositions}"
                            SelectedItem="{Binding SelectedBalancingPosition}" />

                        <Button
                            Width="80"
                            Height="30"
                            Margin="2"
                            Command="{Binding TestBalancingRackPlacedCommand}"
                            Content="测试动平衡" />
                    </StackPanel>
                </ScrollViewer>

                <!--  添加任务数据位置  -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid
                        Margin="6"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding TaskRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding PlateNo}"
                                Header="版号" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Sequence}"
                                Header="序号" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Step}"
                                Header="当前工序" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding ProcessType}"
                                Header="工序" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding State}"
                                Header="工件状态" />
                            <DataGridTemplateColumn Width="90" Header="交互">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Height="26"
                                            Margin="2"
                                            Command="{Binding ToggleRunCommand}"
                                            Content="{Binding ActionText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Grid>
        </Border>
        <!--  下拉框 第二部分  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="4"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <!--<Grid
                    MinWidth="300"
                    MinHeight="560"
                    Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        ~1~  0: 选择设备  @1@
                        <RowDefinition Height="Auto" />
                        ~1~  1: 单次距离  @1@
                        <RowDefinition Height="Auto" />
                        ~1~  2: 相对速度(点动用)  @1@
                        <RowDefinition Height="Auto" />
                        ~1~  3: 绝对速度 + [应用]  @1@
                        <RowDefinition Height="Auto" />
                        ~1~  4: 目标坐标 + [绝对移动]  @1@
                        <RowDefinition Height="Auto" />
                        ~1~  5: 手动动作  @1@
                        <RowDefinition Height="Auto" />
                        ~1~  6: 按钮区  @1@
                        <RowDefinition Height="*" />
                        ~1~  7: 日志关键字  @1@
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="选择设备" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="200"
                        MaxWidth="400"
                        Margin="4"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding ManualControl.DeviceItems}"
                        SelectedItem="{Binding ManualControl.SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="2"
                        Margin="4,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{Binding ManualControl.SelectedDeviceDisplay}"
                        TextWrapping="Wrap" />

                    ~1~  1: 相对移动距离(所有轴共用)  @1@
                    <TextBlock
                        Grid.Row="1"
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="距离(mm)" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="80"
                        Margin="4"
                        HorizontalAlignment="Left"
                        Text="{Binding ManualControl.RelativeMoveDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    ~1~  2: 相对移动方向按钮(基于当前坐标±距离 → 绝对移动)  @1@
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="4,4,4,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <Button
                            Width="36"
                            Height="26"
                            Margin="1"
                            Command="{Binding ManualControl.RelativeMoveXMinusCommand}"
                            Content="X-" />
                        <Button
                            Width="36"
                            Height="26"
                            Margin="1"
                            Command="{Binding ManualControl.RelativeMoveXPlusCommand}"
                            Content="X+" />
                        <Button
                            Width="36"
                            Height="26"
                            Margin="6,1,1,1"
                            Command="{Binding ManualControl.RelativeMoveYMinusCommand}"
                            Content="Y-" />
                        <Button
                            Width="36"
                            Height="26"
                            Margin="1"
                            Command="{Binding ManualControl.RelativeMoveYPlusCommand}"
                            Content="Y+" />
                        <Button
                            Width="36"
                            Height="26"
                            Margin="6,1,1,1"
                            Command="{Binding ManualControl.RelativeMoveZMinusCommand}"
                            Content="Z-" />
                        <Button
                            Width="36"
                            Height="26"
                            Margin="1"
                            Command="{Binding ManualControl.RelativeMoveZPlusCommand}"
                            Content="Z+" />
                    </StackPanel>

                    ~1~  绝对运动 速度设置(绝对移动用，每轴独立)  @1@
                    <TextBlock
                        Grid.Row="3"
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="绝对速X" />
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <TextBox
                            Width="45"
                            Margin="0,4,2,4"
                            Text="{Binding ManualControl.AbsSpeedX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="2,4"
                            VerticalAlignment="Center"
                            Text="加" />
                        <TextBox
                            Width="45"
                            Margin="2,4"
                            Text="{Binding ManualControl.AbsAccelX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="2,4"
                            VerticalAlignment="Center"
                            Text="减" />
                        <TextBox
                            Width="45"
                            Margin="2,4"
                            Text="{Binding ManualControl.AbsDecelX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="6,4,2,4"
                            VerticalAlignment="Center"
                            Text="Y" />
                        <TextBox
                            Width="45"
                            Margin="2,4"
                            Text="{Binding ManualControl.AbsSpeedY, Mode=TwoWay}" />
                        <TextBlock
                            Margin="2,4"
                            VerticalAlignment="Center"
                            Text="加" />
                        <TextBox
                            Width="45"
                            Margin="2,4"
                            Text="{Binding ManualControl.AbsAccelY, Mode=TwoWay}" />
                        <TextBlock
                            Margin="2,4"
                            VerticalAlignment="Center"
                            Text="减" />
                        <TextBox
                            Width="45"
                            Margin="2,4"
                            Text="{Binding ManualControl.AbsDecelY, Mode=TwoWay}" />
                        <TextBlock
                            Margin="6,4,2,4"
                            VerticalAlignment="Center"
                            Text="Z" />
                        <TextBox
                            Width="45"
                            Margin="2,4"
                            Text="{Binding ManualControl.AbsSpeedZ, Mode=TwoWay}" />
                        <TextBlock
                            Margin="2,4"
                            VerticalAlignment="Center"
                            Text="加" />
                        <TextBox
                            Width="45"
                            Margin="2,4"
                            Text="{Binding ManualControl.AbsAccelZ, Mode=TwoWay}" />
                        <TextBlock
                            Margin="2,4"
                            VerticalAlignment="Center"
                            Text="减" />
                        <TextBox
                            Width="45"
                            Margin="2,4"
                            Text="{Binding ManualControl.AbsDecelZ, Mode=TwoWay}" />
                    </StackPanel>
                    <Button
                        Grid.Row="3"
                        Grid.Column="2"
                        Width="70"
                        Height="26"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Command="{Binding ManualControl.SetAbsSpeedCommand}"
                        Content="应用速度" />

                    ~1~  绝对位移 目标坐标 + 移动按钮  @1@
                    <TextBlock
                        Grid.Row="4"
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="目标(mm)" />
                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,4,2,4"
                            VerticalAlignment="Center"
                            Text="X" />
                        <TextBox
                            Width="50"
                            Margin="0,4,2,4"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}"
                            Text="{Binding ManualControl.AbsXTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="4,4,2,4"
                            VerticalAlignment="Center"
                            Text="Y" />
                        <TextBox
                            Width="50"
                            Margin="0,4,2,4"
                            Text="{Binding ManualControl.AbsYTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="4,4,2,4"
                            VerticalAlignment="Center"
                            Text="Z" />
                        <TextBox
                            Width="50"
                            Margin="0,4,2,4"
                            Text="{Binding ManualControl.AbsZTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="5"
                        Grid.Column="0"
                        Orientation="Horizontal">
                        <Button
                            Width="32"
                            Height="26"
                            Margin="0,0,2,0"
                            VerticalAlignment="Center"
                            Command="{Binding ManualControl.RefreshTargetCommand}"
                            Content="📍"
                            ToolTip="读取当前位置填入目标框" />
                        <Button
                            Width="60"
                            Height="26"
                            Margin="0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ManualControl.MoveAbsoluteCommand}"
                            Content="绝对移动" />
                    </StackPanel>


                    <UniformGrid
                        Grid.Row="6"
                        Grid.ColumnSpan="2"
                        Width="300"
                        Margin="2"
                        HorizontalAlignment="Left"
                        Columns="2">
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.StopCommand}"
                            Content="减速停止" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.EStopCommand}"
                            Content="急停" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.HomeXCommand}"
                            Content="X回原点"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.HomeYCommand}"
                            Content="Y回原点" />

                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.HomeZCommand}"
                            Content="Z回原点" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.ClearFaultCommand}"
                            Content="清除报警" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.ServoPowerOnCommand}"
                            Content="伺服通电" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.ServoPowerOffCommand}"
                            Content="伺服断电" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.MagnetOnCommand}"
                            Content="磁铁吸合"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.MagnetOffCommand}"
                            Content="磁铁释放"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.DrainOpenCommand}"
                            Content="接液盘打开"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.DrainCloseCommand}"
                            Content="接液盘关闭"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Border Margin="2" />
                        <Border Margin="2" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="7"
                        Grid.ColumnSpan="3"
                        Margin="6,10,6,0"
                        FontWeight="Bold"
                        Text="日志关键字：[CraneManualVM] / [CraneService] / [ModbusTcpClient]" />
                </Grid>-->
                <StackPanel Margin="8">
                    <!--  设备  -->
                    <GroupBox Margin="0,0,0,8" Header="设备选择">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Width="150"
                                Height="20"
                                HorizontalAlignment="Left"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding ManualControl.DeviceItems}"
                                SelectedItem="{Binding ManualControl.SelectedDevice}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{Binding ManualControl.SelectedDeviceDisplay}" />
                        </Grid>
                    </GroupBox>

                    <!--  点动  -->
                    <GroupBox Margin="0,0,0,8" Header="相对移动">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="80"
                                    VerticalAlignment="Center"
                                    Text="距离(mm)" />
                                <TextBox Width="100" Text="{Binding ManualControl.RelativeMoveDistance}" />
                            </StackPanel>

                            <UniformGrid
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Columns="6">

                                <Button
                                    Width="50"
                                    Height="30"
                                    Command="{Binding ManualControl.RelativeMoveXMinusCommand}"
                                    Content="X-" />
                                <Button
                                    Width="50"
                                    Height="30"
                                    Command="{Binding ManualControl.RelativeMoveXPlusCommand}"
                                    Content="X+" />
                                <Button
                                    Width="50"
                                    Height="30"
                                    Command="{Binding ManualControl.RelativeMoveYMinusCommand}"
                                    Content="Y-" />
                                <Button
                                    Width="50"
                                    Height="30"
                                    Command="{Binding ManualControl.RelativeMoveYPlusCommand}"
                                    Content="Y+" />
                                <Button
                                    Width="50"
                                    Height="30"
                                    Command="{Binding ManualControl.RelativeMoveZMinusCommand}"
                                    Content="Z-" />
                                <Button
                                    Width="50"
                                    Height="30"
                                    Command="{Binding ManualControl.RelativeMoveZPlusCommand}"
                                    Content="Z+" />
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>


                    <!--  速度  -->
                    <GroupBox Margin="0,0,0,8" Header="绝对运动参数">

                        <Grid Margin="6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  X  -->
                            <TextBlock
                                Grid.Row="0"
                                VerticalAlignment="Center"
                                Text="X" />

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding ManualControl.AbsSpeedX}" />

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="2"
                                Text="{Binding ManualControl.AbsAccelX}" />

                            <TextBox
                                Grid.Row="0"
                                Grid.Column="3"
                                Text="{Binding ManualControl.AbsDecelX}" />

                            <!--  Y  -->
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Text="Y" />

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding ManualControl.AbsSpeedY}" />

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="2"
                                Text="{Binding ManualControl.AbsAccelY}" />

                            <TextBox
                                Grid.Row="1"
                                Grid.Column="3"
                                Text="{Binding ManualControl.AbsDecelY}" />

                            <!--  Z  -->
                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                Text="Z" />

                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding ManualControl.AbsSpeedZ}" />

                            <TextBox
                                Grid.Row="2"
                                Grid.Column="2"
                                Text="{Binding ManualControl.AbsAccelZ}" />

                            <TextBox
                                Grid.Row="2"
                                Grid.Column="3"
                                Text="{Binding ManualControl.AbsDecelZ}" />

                            <Button
                                Grid.RowSpan="3"
                                Grid.Column="4"
                                Margin="8,0,0,0"
                                Command="{Binding ManualControl.SetAbsSpeedCommand}"
                                Content="应用速度" />
                        </Grid>

                    </GroupBox>
                    <!--  目标位置  -->
                    <GroupBox Margin="0,0,0,8" Header="目标位置">

                        <StackPanel Margin="6">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock VerticalAlignment="Center" Text="X" />
                                <TextBox
                                    Width="80"
                                    Margin="4,0"
                                    Text="{Binding ManualControl.AbsXTarget}" />

                                <TextBlock VerticalAlignment="Center" Text="Y" />
                                <TextBox
                                    Width="80"
                                    Margin="4,0"
                                    Text="{Binding ManualControl.AbsYTarget}" />

                                <TextBlock VerticalAlignment="Center" Text="Z" />
                                <TextBox
                                    Width="80"
                                    Margin="4,0"
                                    Text="{Binding ManualControl.AbsZTarget}" />

                            </StackPanel>

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">

                                <Button
                                    Width="120"
                                    Command="{Binding ManualControl.RefreshTargetCommand}"
                                    Content="读取当前位置" />

                                <Button
                                    Width="120"
                                    Margin="8,0,0,0"
                                    Command="{Binding ManualControl.MoveAbsoluteCommand}"
                                    Content="绝对移动" />
                            </StackPanel>

                        </StackPanel>

                    </GroupBox>
                    <!--  动作  -->
                    <GroupBox Header="设备操作">

                        <UniformGrid Columns="2">

                            <Button Command="{Binding ManualControl.StopCommand}" Content="减速停止" />

                            <Button Command="{Binding ManualControl.EStopCommand}" Content="急停" />

                            <Button Command="{Binding ManualControl.HomeXCommand}" Content="X回原点" />

                            <Button Command="{Binding ManualControl.HomeYCommand}" Content="Y回原点" />

                            <Button Command="{Binding ManualControl.HomeZCommand}" Content="Z回原点" />

                            <Button Command="{Binding ManualControl.ClearFaultCommand}" Content="清除报警" />

                            <Button Command="{Binding ManualControl.ServoPowerOnCommand}" Content="伺服通电" />

                            <Button Command="{Binding ManualControl.ServoPowerOffCommand}" Content="伺服断电" />

                            <Button Command="{Binding ManualControl.MagnetOnCommand}" Content="磁铁吸合" />

                            <Button Command="{Binding ManualControl.MagnetOffCommand}" Content="磁铁释放" />

                            <Button Command="{Binding ManualControl.DrainOpenCommand}" Content="接液盘打开" />

                            <Button Command="{Binding ManualControl.DrainCloseCommand}" Content="接液盘关闭" />

                        </UniformGrid>

                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </Border>
        <!--  第三部分  -->
        <Border
            Grid.Row="1"
            Grid.Column="2"
            Margin="4"
            Background="#FFFDF4D6"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MinWidth="1400"
                    MinHeight="560"
                    Margin="6">
                    <TextBlock
                        Margin="2,2,2,8"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="天车 / 机械手 黄台总览" />
                    <!--  自定义控件  -->
                    <UniformGrid Margin="0,0,0,6" Columns="5">
                        <!--  1号线天车前   绑定的HomeViewModel的数据  -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane1F.CraneName}"
                            Btn1="急停"
                            Btn1Command="{Binding Crane1F.EStopCommand}"
                            Btn2="伺服断电"
                            Btn2Command="{Binding Crane1F.ServoPowerOffCommand}"
                            Btn3="伺服通电"
                            Btn3Command="{Binding Crane1F.ServoPowerOnCommand}"
