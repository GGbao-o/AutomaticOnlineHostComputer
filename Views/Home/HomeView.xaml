<UserControl x:Class="AutomaticOnlineHostComputer.Views.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AutomaticOnlineHostComputer.Views.Home.Controls"
             Background="#F0F2F5">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Margin="4,0,4,2" BorderBrush="#F59E0B" BorderThickness="1" Background="#FFF7ED" Padding="6,4">
            <DockPanel>
                <TextBlock Text="" DockPanel.Dock="Left" />
                <Button Content="线路选取" DockPanel.Dock="Right" Width="96" Height="28" Margin="0,0,2,0" Click="RouteSelect_Click" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="6">
                    <Button Content="添加任务" Width="84" Height="30" Margin="2" Click="AddTask_Click" />
                    <Button Content="启动一号线" Width="90" Height="30" Margin="2" />
                    <Button Content="启动二号线" Width="90" Height="30" Margin="2" />
                    <Button Content="启动研磨" Width="84" Height="30" Margin="2" />
                </StackPanel>
                <DataGrid Grid.Row="1" Margin="6" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="*" />
                        <DataGridTextColumn Header="当前工序" Binding="{Binding Step}" Width="*" />
                        <DataGridTextColumn Header="工件状态" Binding="{Binding State}" Width="*" />
                        <DataGridTextColumn Header="交互" Binding="{Binding Action}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid MinWidth="320" MinHeight="560" Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="选择天车" Margin="4" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Margin="4" MinWidth="140"
                              ItemsSource="{Binding ManualControl.CraneNumbers}"
                              SelectedItem="{Binding ManualControl.SelectedCraneNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="2" Margin="4" VerticalAlignment="Center"
                               Text="{Binding ManualControl.SelectedCraneDisplay}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="单次运动距离(脉冲)" Margin="4" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4"
                             Text="{Binding ManualControl.StepDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="4" VerticalAlignment="Center"
                               Text="手动控制模式" />
                    <TextBlock Grid.Row="2" Text="手动动作" Margin="4" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="4" Text="所有动作均输出控制台日志" Foreground="#B45309" />
                    <UniformGrid Grid.Row="3" Grid.ColumnSpan="3" Columns="4" Margin="2">
                        <Button Content="X+" Margin="2" Height="32" Command="{Binding ManualControl.XPlusCommand}" />
                        <Button Content="X-" Margin="2" Height="32" Command="{Binding ManualControl.XMinusCommand}" />
                        <Button Content="停止运动" Margin="2" Height="32" Command="{Binding ManualControl.StopCommand}" />
                        <Button Content="X回原点" Margin="2" Height="32" Command="{Binding ManualControl.HomeXCommand}" />
                        <Button Content="Y+" Margin="2" Height="32" Command="{Binding ManualControl.YPlusCommand}" />
                        <Button Content="Y-" Margin="2" Height="32" Command="{Binding ManualControl.YMinusCommand}" />
                        <Button Content="Y回原点" Margin="2" Height="32" Command="{Binding ManualControl.HomeYCommand}" />
                        <Button Content="清除故障" Margin="2" Height="32" Command="{Binding ManualControl.ClearFaultCommand}" />
                        <Button Content="Z+" Margin="2" Height="32" Command="{Binding ManualControl.ZPlusCommand}" />
                        <Button Content="Z-" Margin="2" Height="32" Command="{Binding ManualControl.ZMinusCommand}" />
                        <Button Content="Z回原点" Margin="2" Height="32" Command="{Binding ManualControl.HomeZCommand}" />
                        <Button Content="磁铁吸合" Margin="2" Height="32" Command="{Binding ManualControl.MagnetOnCommand}" />
                        <Button Content="接触器打开" Margin="2" Height="32" Command="{Binding ManualControl.DrainOpenCommand}" />
                        <Button Content="接触器关闭" Margin="2" Height="32" Command="{Binding ManualControl.DrainCloseCommand}" />
                        <Button Content="磁铁释放" Margin="2" Height="32" Command="{Binding ManualControl.MagnetOffCommand}" />
                        <Border Margin="2" />
                    </UniformGrid>
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="日志关键字：[CraneManualVM] / [CraneService] / [ModbusTcpClient]" Margin="6,10,6,0" FontWeight="Bold" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="#FFFDF4D6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6" MinWidth="1400" MinHeight="560">
                    <TextBlock Text="天车 / 机械手 黄台总览" FontSize="16" FontWeight="Bold" Margin="2,2,2,8" />

                    <UniformGrid Columns="5" Margin="0,0,0,6">
                        <!-- 1号线天车前   绑定的HomeViewModel的数据  -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane1F.CraneName}"
                            ConnectedBrush="{Binding Crane1F.ConnectedBrush}"
                            Line1="{Binding Crane1F.Line1}" Line1Brush="{Binding Crane1F.Line1Brush}"
                            Line2="{Binding Crane1F.Line2}" Line2Brush="{Binding Crane1F.Line2Brush}"
                            Line3="{Binding Crane1F.Line3}" Line3Brush="{Binding Crane1F.Line3Brush}"
                            Line4="{Binding Crane1F.Line4}" Line4Brush="{Binding Crane1F.Line4Brush}"
                            Line5="{Binding Crane1F.Line5}" Line5Brush="{Binding Crane1F.Line5Brush}"
                            Btn1="急停"    Btn1Command="{Binding Crane1F.EStopCommand}"
                            Btn2="伺服断电" Btn2Command="{Binding Crane1F.ServoPowerOffCommand}"
                            Btn3="伺服通电" Btn3Command="{Binding Crane1F.ServoPowerOnCommand}"
                            Btn4="清除报警" Btn4Command="{Binding Crane1F.ClearAlarmCommand}"
                            Btn5="充磁"    Btn5Command="{Binding Crane1F.MagnetOnCommand}"
                            Btn6="退磁"    Btn6Command="{Binding Crane1F.MagnetOffCommand}"
                            Btn7="开液盘"  Btn7Command="{Binding Crane1F.DrainOpenCommand}"
                            Btn8="关液盘"  Btn8Command="{Binding Crane1F.DrainCloseCommand}" />
                        <!-- 1号线天车后 -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane1R.CraneName}"
                            ConnectedBrush="{Binding Crane1R.ConnectedBrush}"
                            Line1="{Binding Crane1R.Line1}" Line1Brush="{Binding Crane1R.Line1Brush}"
                            Line2="{Binding Crane1R.Line2}" Line2Brush="{Binding Crane1R.Line2Brush}"
                            Line3="{Binding Crane1R.Line3}" Line3Brush="{Binding Crane1R.Line3Brush}"
                            Line4="{Binding Crane1R.Line4}" Line4Brush="{Binding Crane1R.Line4Brush}"
                            Line5="{Binding Crane1R.Line5}" Line5Brush="{Binding Crane1R.Line5Brush}"
                            Btn1="急停"    Btn1Command="{Binding Crane1R.EStopCommand}"
                            Btn2="伺服断电" Btn2Command="{Binding Crane1R.ServoPowerOffCommand}"
                            Btn3="伺服通电" Btn3Command="{Binding Crane1R.ServoPowerOnCommand}"
                            Btn4="清除报警" Btn4Command="{Binding Crane1R.ClearAlarmCommand}"
                            Btn5="充磁"    Btn5Command="{Binding Crane1R.MagnetOnCommand}"
                            Btn6="退磁"    Btn6Command="{Binding Crane1R.MagnetOffCommand}"
                            Btn7="开液盘"  Btn7Command="{Binding Crane1R.DrainOpenCommand}"
                            Btn8="关液盘"  Btn8Command="{Binding Crane1R.DrainCloseCommand}" />
                        <!-- 2号线天车前 -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane2F.CraneName}"
                            ConnectedBrush="{Binding Crane2F.ConnectedBrush}"
                            Line1="{Binding Crane2F.Line1}" Line1Brush="{Binding Crane2F.Line1Brush}"
                            Line2="{Binding Crane2F.Line2}" Line2Brush="{Binding Crane2F.Line2Brush}"
                            Line3="{Binding Crane2F.Line3}" Line3Brush="{Binding Crane2F.Line3Brush}"
                            Line4="{Binding Crane2F.Line4}" Line4Brush="{Binding Crane2F.Line4Brush}"
                            Line5="{Binding Crane2F.Line5}" Line5Brush="{Binding Crane2F.Line5Brush}"
                            Btn1="急停"    Btn1Command="{Binding Crane2F.EStopCommand}"
                            Btn2="伺服断电" Btn2Command="{Binding Crane2F.ServoPowerOffCommand}"
                            Btn3="伺服通电" Btn3Command="{Binding Crane2F.ServoPowerOnCommand}"
                            Btn4="清除报警" Btn4Command="{Binding Crane2F.ClearAlarmCommand}"
                            Btn5="充磁"    Btn5Command="{Binding Crane2F.MagnetOnCommand}"
                            Btn6="退磁"    Btn6Command="{Binding Crane2F.MagnetOffCommand}"
                            Btn7="开液盘"  Btn7Command="{Binding Crane2F.DrainOpenCommand}"
                            Btn8="关液盘"  Btn8Command="{Binding Crane2F.DrainCloseCommand}" />
                        <!-- 2号线天车后 -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane2R.CraneName}"
                            ConnectedBrush="{Binding Crane2R.ConnectedBrush}"
                            Line1="{Binding Crane2R.Line1}" Line1Brush="{Binding Crane2R.Line1Brush}"
                            Line2="{Binding Crane2R.Line2}" Line2Brush="{Binding Crane2R.Line2Brush}"
                            Line3="{Binding Crane2R.Line3}" Line3Brush="{Binding Crane2R.Line3Brush}"
                            Line4="{Binding Crane2R.Line4}" Line4Brush="{Binding Crane2R.Line4Brush}"
                            Line5="{Binding Crane2R.Line5}" Line5Brush="{Binding Crane2R.Line5Brush}"
                            Btn1="急停"    Btn1Command="{Binding Crane2R.EStopCommand}"
                            Btn2="伺服断电" Btn2Command="{Binding Crane2R.ServoPowerOffCommand}"
                            Btn3="伺服通电" Btn3Command="{Binding Crane2R.ServoPowerOnCommand}"
                            Btn4="清除报警" Btn4Command="{Binding Crane2R.ClearAlarmCommand}"
                            Btn5="充磁"    Btn5Command="{Binding Crane2R.MagnetOnCommand}"
                            Btn6="退磁"    Btn6Command="{Binding Crane2R.MagnetOffCommand}"
                            Btn7="开液盘"  Btn7Command="{Binding Crane2R.DrainOpenCommand}"
                            Btn8="关液盘"  Btn8Command="{Binding Crane2R.DrainCloseCommand}" />
                        <!-- 研磨机天车 -->
                        <controls:OverviewDeviceCard
                            Title="{Binding CraneGL.CraneName}"
                            ConnectedBrush="{Binding CraneGL.ConnectedBrush}"
                            Line1="{Binding CraneGL.Line1}" Line1Brush="{Binding CraneGL.Line1Brush}"
                            Line2="{Binding CraneGL.Line2}" Line2Brush="{Binding CraneGL.Line2Brush}"
                            Line3="{Binding CraneGL.Line3}" Line3Brush="{Binding CraneGL.Line3Brush}"
                            Line4="{Binding CraneGL.Line4}" Line4Brush="{Binding CraneGL.Line4Brush}"
                            Line5="{Binding CraneGL.Line5}" Line5Brush="{Binding CraneGL.Line5Brush}"
                            Btn1="急停"    Btn1Command="{Binding CraneGL.EStopCommand}"
                            Btn2="伺服断电" Btn2Command="{Binding CraneGL.ServoPowerOffCommand}"
                            Btn3="伺服通电" Btn3Command="{Binding CraneGL.ServoPowerOnCommand}"
                            Btn4="清除报警" Btn4Command="{Binding CraneGL.ClearAlarmCommand}"
                            Btn5="充磁"    Btn5Command="{Binding CraneGL.MagnetOnCommand}"
                            Btn6="退磁"    Btn6Command="{Binding CraneGL.MagnetOffCommand}"
                            Btn7="开液盘"  Btn7Command="{Binding CraneGL.DrainOpenCommand}"
                            Btn8="关液盘"  Btn8Command="{Binding CraneGL.DrainCloseCommand}" />
                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,2,0,4">
                        <controls:OverviewDeviceCard Title="1-机械手" Line1="已连接，已回零" Line2="无任务" Line3="未知" Line4="退避完成" Line5="接线器打开" Btn1="急停Y" Btn2="驱动Y" Btn3="正极Y" Btn4="负极Y" Btn5="过速Y" Btn6="正极Z" Btn7="负极Z" Btn8="强制Y" />
                        <controls:OverviewDeviceCard Title="2-机械手" Line1="已连接，已回零" Line2="无任务" Line3="未知" Line4="退避完成" Line5="接线器打开" Btn1="急停Y" Btn2="驱动Y" Btn3="正极Y" Btn4="负极Y" Btn5="过速Y" Btn6="正极Z" Btn7="负极Z" Btn8="强制Y" />
                        <controls:OverviewDeviceCard Title="3-机械手" Line1="已连接，已回零" Line2="无任务" Line3="未知" Line4="退避完成" Line5="接线器打开" Btn1="急停Y" Btn2="驱动Y" Btn3="正极Y" Btn4="负极Y" Btn5="过速Y" Btn6="正极Z" Btn7="负极Z" Btn8="强制Y" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid Margin="6" MinWidth="4700" MinHeight="520">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="120" /><RowDefinition Height="120" /><RowDefinition Height="120" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="24" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="26" Text="全厂下位机状态 / 全流程机器状态图" FontSize="16" FontWeight="Bold" Margin="2,2,2,10" />

                    <controls:StatusCard Grid.Row="1" Grid.Column="0" CardTitle="01总上料架" Status1="{Binding Status1_01,FallbackValue=未知}" Status2="{Binding Status2_01,FallbackValue=无}" IpText="{Binding IpMap[ST001],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="1" CardTitle="02机械手1" Status1="{Binding Status1_02,FallbackValue=未知}" Status2="{Binding Status2_02,FallbackValue=无}" IpText="{Binding IpMap[ST002],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="3" CardTitle="11货叉1(上料架1)" Status1="{Binding Status1_11,FallbackValue=未知}" Status2="{Binding Status2_11,FallbackValue=无}" IpText="{Binding IpMap[ST011],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="4" CardTitle="18一号双头镗" Status1="{Binding Status1_18,FallbackValue=未知}" Status2="{Binding Status2_18,FallbackValue=无}" IpText="{Binding IpMap[ST401],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="5" CardTitle="19一号打号机" Status1="{Binding Status1_19,FallbackValue=未知}" Status2="{Binding Status2_19,FallbackValue=无}" IpText="{Binding IpMap[ST501],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="6" CardTitle="03中转站1" Status1="{Binding Status1_03_1,FallbackValue=未知}" Status2="{Binding Status2_03_1,FallbackValue=无}" IpText="{Binding IpMap[ST031],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="7" CardTitle="03中转站2" Status1="{Binding Status1_03_2,FallbackValue=未知}" Status2="{Binding Status2_03_2,FallbackValue=无}" IpText="{Binding IpMap[ST032],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="8" CardTitle="03中转站3" Status1="{Binding Status1_03_3,FallbackValue=未知}" Status2="{Binding Status2_03_3,FallbackValue=无}" IpText="{Binding IpMap[ST033],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="9" CardTitle="20一号斜床" Status1="{Binding Status1_20,FallbackValue=未知}" Status2="{Binding Status2_20,FallbackValue=无}" IpText="{Binding IpMap[ST601],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="10" CardTitle="21二号斜床" Status1="{Binding Status1_21,FallbackValue=未知}" Status2="{Binding Status2_21,FallbackValue=无}" IpText="{Binding IpMap[ST602],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="11" CardTitle="22三号斜床" Status1="{Binding Status1_22,FallbackValue=未知}" Status2="{Binding Status2_22,FallbackValue=无}" IpText="{Binding IpMap[ST603],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="12" CardTitle="23四号斜床" Status1="{Binding Status1_23,FallbackValue=未知}" Status2="{Binding Status2_23,FallbackValue=无}" IpText="{Binding IpMap[ST604],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="13" CardTitle="24五号斜床" Status1="{Binding Status1_24,FallbackValue=未知}" Status2="{Binding Status2_24,FallbackValue=无}" IpText="{Binding IpMap[ST605],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="14" CardTitle="13下料架1" Status1="{Binding Status1_13,FallbackValue=未知}" Status2="{Binding Status2_13,FallbackValue=无}" IpText="{Binding IpMap[ST013],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="15" CardTitle="05机械手2" Status1="{Binding Status1_05,FallbackValue=未知}" Status2="{Binding Status2_05,FallbackValue=无}" IpText="{Binding IpMap[ST005],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="16" CardTitle="06机械手3" Status1="{Binding Status1_06,FallbackValue=未知}" Status2="{Binding Status2_06,FallbackValue=无}" IpText="{Binding IpMap[ST006],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="17" CardTitle="15下料架2(研磨机上料架)" Status1="{Binding Status1_15,FallbackValue=未知}" Status2="{Binding Status2_15,FallbackValue=无}" IpText="{Binding IpMap[ST709],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="18" CardTitle="17研磨机上料5" Status1="{Binding Status1_17_5,FallbackValue=未知}" Status2="{Binding Status2_17_5,FallbackValue=无}" IpText="{Binding IpMap[ST175],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="19" CardTitle="17研磨机上料6" Status1="{Binding Status1_17_6,FallbackValue=未知}" Status2="{Binding Status2_17_6,FallbackValue=无}" IpText="{Binding IpMap[ST176],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="20" CardTitle="17研磨机上料7" Status1="{Binding Status1_17_7,FallbackValue=未知}" Status2="{Binding Status2_17_7,FallbackValue=无}" IpText="{Binding IpMap[ST177],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="21" CardTitle="32研磨机1" Status1="{Binding Status1_32_1,FallbackValue=未知}" Status2="{Binding Status2_32_1,FallbackValue=无}" IpText="{Binding IpMap[ST701],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="22" CardTitle="32研磨机2" Status1="{Binding Status1_32_2,FallbackValue=未知}" Status2="{Binding Status2_32_2,FallbackValue=无}" IpText="{Binding IpMap[ST702],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="23" CardTitle="32研磨机3" Status1="{Binding Status1_32_3,FallbackValue=未知}" Status2="{Binding Status2_32_3,FallbackValue=无}" IpText="{Binding IpMap[ST703],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="24" CardTitle="32研磨机4" Status1="{Binding Status1_32_4,FallbackValue=未知}" Status2="{Binding Status2_32_4,FallbackValue=无}" IpText="{Binding IpMap[ST704],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="1" Grid.Column="25" CardTitle="17研磨机下料架" Status1="{Binding Status1_17_D,FallbackValue=未知}" Status2="{Binding Status2_17_D,FallbackValue=无}" IpText="{Binding IpMap[ST710],FallbackValue=未配置IP}" />

                    <controls:StatusCard Grid.Row="2" Grid.Column="3" CardTitle="12货叉2(上料架2)" Status1="{Binding Status1_12,FallbackValue=未知}" Status2="{Binding Status2_12,FallbackValue=无}" IpText="{Binding IpMap[ST012],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="2" Grid.Column="4" CardTitle="25二号双头镗" Status1="{Binding Status1_25,FallbackValue=未知}" Status2="{Binding Status2_25,FallbackValue=无}" IpText="{Binding IpMap[ST402],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="2" Grid.Column="5" CardTitle="26二号打号机" Status1="{Binding Status1_26,FallbackValue=未知}" Status2="{Binding Status2_26,FallbackValue=无}" IpText="{Binding IpMap[ST502],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="2" Grid.Column="6" CardTitle="04中转站4" Status1="{Binding Status1_04_4,FallbackValue=未知}" Status2="{Binding Status2_04_4,FallbackValue=无}" IpText="{Binding IpMap[ST041],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="2" Grid.Column="7" CardTitle="04中转站5" Status1="{Binding Status1_04_5,FallbackValue=未知}" Status2="{Binding Status2_04_5,FallbackValue=无}" IpText="{Binding IpMap[ST042],FallbackValue=未配置IP}" />
                    <controls:StatusCard Grid.Row="2" Grid.Column="8" CardTitle="04中转站6" Status1="{Binding Status1_04_6,FallbackValue=未知}" Status2="{Binding Status2_04_6,FallbackValue=无}" IpText="{Binding IpMap[ST043],FallbackValue=未配置IP}" />
