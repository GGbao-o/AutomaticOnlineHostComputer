<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.Home.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AutomaticOnlineHostComputer.Views.Home.Controls"
    Background="#F0F2F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="4,0,4,2"
            Padding="6,4"
            Background="#FFF7ED"
            BorderBrush="#F59E0B"
            BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="" />
                <Button
                    Width="96"
                    Height="28"
                    Margin="0,0,2,0"
                    Click="RouteSelect_Click"
                    Content="线路选取"
                    DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
        <!--  第一部分  -->
        <Border
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            Margin="4"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="6" Orientation="Horizontal">
                    <Button
                        Width="84"
                        Height="30"
                        Margin="2"
                        Click="AddTask_Click"
                        Content="添加任务" />
                    <Button
                        Width="90"
                        Height="30"
                        Margin="2"
                        Command="{Binding Line1ToggleCommand}"
                        Content="{Binding Line1ToggleText}" />
                    <Button
                        Width="90"
                        Height="30"
                        Margin="2"
                        Content="启动二号线" />
                    <Button
                        Width="84"
                        Height="30"
                        Margin="2"
                        Content="启动研磨" />
                </StackPanel>
                <DataGrid
                    Grid.Row="1"
                    Margin="6"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding TaskRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding PlateNo}"
                            Header="版号" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Sequence}"
                            Header="序号" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Step}"
                            Header="当前工序" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding ProcessType}"
                            Header="工序" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding State}"
                            Header="工件状态" />
                        <DataGridTemplateColumn Width="90" Header="交互">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Height="26"
                                        Margin="2"
                                        Command="{Binding ToggleRunCommand}"
                                        Content="{Binding ActionText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <!--  下拉框 第二部分  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="4"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid
                    MinWidth="320"
                    MinHeight="560"
                    Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!--  0: 选择设备  -->
                        <RowDefinition Height="Auto" />
                        <!--  1: 单次距离  -->
                        <RowDefinition Height="Auto" />
                        <!--  2: 相对速度(点动用)  -->
                        <RowDefinition Height="Auto" />
                        <!--  3: 绝对速度 + [应用]  -->
                        <RowDefinition Height="Auto" />
                        <!--  4: 目标坐标 + [绝对移动]  -->
                        <RowDefinition Height="Auto" />
                        <!--  5: 手动动作  -->
                        <RowDefinition Height="Auto" />
                        <!--  6: 按钮区  -->
                        <RowDefinition Height="*" />
                        <!--  7: 日志关键字  -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="选择设备" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        Margin="4"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding ManualControl.DeviceItems}"
                        SelectedItem="{Binding ManualControl.SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="2"
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="{Binding ManualControl.SelectedDeviceDisplay}"
                        TextWrapping="Wrap" />
                    <!--  单次运动距离  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="单次距离(mm)" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4"
                        Text="{Binding ManualControl.StepDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="手动控制模式" />

                    <!--  相对运动 速度/加减速设置（每轴独立）  -->
                    <TextBlock Grid.Row="2" Margin="4" VerticalAlignment="Center" Text="相对速X" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="45" Margin="0,4,2,4" Text="{Binding ManualControl.RelSpeedX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="加" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.RelAccelX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="减" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.RelDecelX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="6,4,2,4" VerticalAlignment="Center" Text="Y" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.RelSpeedY, Mode=TwoWay}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="加" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.RelAccelY, Mode=TwoWay}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="减" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.RelDecelY, Mode=TwoWay}" />
                        <TextBlock Margin="6,4,2,4" VerticalAlignment="Center" Text="Z" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.RelSpeedZ, Mode=TwoWay}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="加" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.RelAccelZ, Mode=TwoWay}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="减" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.RelDecelZ, Mode=TwoWay}" />
                    </StackPanel>
                    <Button Grid.Row="2" Grid.Column="2" Width="70" Height="26" Margin="4,0"
                            VerticalAlignment="Center" Command="{Binding ManualControl.SetRelSpeedCommand}" Content="应用速度" />

                    <!--  绝对运动 速度设置(绝对移动用，每轴独立)  -->
                    <TextBlock Grid.Row="3" Margin="4" VerticalAlignment="Center" Text="绝对速X" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="45" Margin="0,4,2,4" Text="{Binding ManualControl.AbsSpeedX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="加" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.AbsAccelX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="减" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.AbsDecelX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="6,4,2,4" VerticalAlignment="Center" Text="Y" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.AbsSpeedY, Mode=TwoWay}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="加" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.AbsAccelY, Mode=TwoWay}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="减" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.AbsDecelY, Mode=TwoWay}" />
                        <TextBlock Margin="6,4,2,4" VerticalAlignment="Center" Text="Z" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.AbsSpeedZ, Mode=TwoWay}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="加" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.AbsAccelZ, Mode=TwoWay}" />
                        <TextBlock Margin="2,4" VerticalAlignment="Center" Text="减" /><TextBox Width="45" Margin="2,4" Text="{Binding ManualControl.AbsDecelZ, Mode=TwoWay}" />
                    </StackPanel>
                    <Button Grid.Row="3" Grid.Column="2" Width="70" Height="26" Margin="4,0"
                            VerticalAlignment="Center" Command="{Binding ManualControl.SetAbsSpeedCommand}" Content="应用速度" />

                    <!--  绝对位移 目标坐标 + 移动按钮  -->
                    <TextBlock
                        Grid.Row="4"
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="目标(mm)" />
                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,4,2,4"
                            VerticalAlignment="Center"
                            Text="X" />
                        <TextBox
                            Width="50"
                            Margin="0,4,2,4"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}"
                            Text="{Binding ManualControl.AbsXTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="4,4,2,4"
                            VerticalAlignment="Center"
                            Text="Y" />
                        <TextBox
                            Width="50"
                            Margin="0,4,2,4"
                            Text="{Binding ManualControl.AbsYTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="4,4,2,4"
                            VerticalAlignment="Center"
                            Text="Z" />
                        <TextBox
                            Width="50"
                            Margin="0,4,2,4"
                            Text="{Binding ManualControl.AbsZTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="2"
                        Orientation="Horizontal">
                        <Button
                            Width="32"
                            Height="26"
                            Margin="0,0,2,0"
                            VerticalAlignment="Center"
                            Command="{Binding ManualControl.RefreshTargetCommand}"
                            Content="📍"
                            ToolTip="读取当前位置填入目标框" />
                        <Button
                            Width="60"
                            Height="26"
                            Margin="0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ManualControl.MoveAbsoluteCommand}"
                            Content="绝对移动" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="5"
                        Margin="4"
                        VerticalAlignment="Center"
                        Text="手动动作" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="4"
                        Foreground="#B45309"
                        Text="所有动作均输出控制台日志" />
                    <UniformGrid
                        Grid.Row="6"
                        Grid.ColumnSpan="3"
                        Margin="2"
                        Columns="4">
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.XPlusCommand}"
                            Content="X+"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.XMinusCommand}"
                            Content="X-"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.StopCommand}"
                            Content="减速停止" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.EStopCommand}"
                            Content="急停" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.YPlusCommand}"
                            Content="Y+" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.YMinusCommand}"
                            Content="Y-" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.HomeXCommand}"
                            Content="X回原点"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.HomeYCommand}"
                            Content="Y回原点" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.ZPlusCommand}"
                            Content="Z+" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.ZMinusCommand}"
                            Content="Z-" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.HomeZCommand}"
                            Content="Z回原点" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.ClearFaultCommand}"
                            Content="清除报警" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.ServoPowerOnCommand}"
                            Content="伺服通电" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.ServoPowerOffCommand}"
                            Content="伺服断电" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.MagnetOnCommand}"
                            Content="磁铁吸合"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.MagnetOffCommand}"
                            Content="磁铁释放"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.DrainOpenCommand}"
                            Content="接液盘打开"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Button
                            Height="32"
                            Margin="2"
                            Command="{Binding ManualControl.DrainCloseCommand}"
                            Content="接液盘关闭"
                            IsEnabled="{Binding ManualControl.IsCraneSelected}" />
                        <Border Margin="2" />
                        <Border Margin="2" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="7"
                        Grid.ColumnSpan="3"
                        Margin="6,10,6,0"
                        FontWeight="Bold"
                        Text="日志关键字：[CraneManualVM] / [CraneService] / [ModbusTcpClient]" />
                </Grid>
            </ScrollViewer>
        </Border>
        <!--  第三部分  -->
        <Border
            Grid.Row="1"
            Grid.Column="2"
            Margin="4"
            Background="#FFFDF4D6"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MinWidth="1400"
                    MinHeight="560"
                    Margin="6">
                    <TextBlock
                        Margin="2,2,2,8"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="天车 / 机械手 黄台总览" />
                    <!--  自定义控件  -->
                    <UniformGrid Margin="0,0,0,6" Columns="5">
                        <!--  1号线天车前   绑定的HomeViewModel的数据  -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane1F.CraneName}"
                            Btn1="急停"
                            Btn1Command="{Binding Crane1F.EStopCommand}"
                            Btn2="伺服断电"
                            Btn2Command="{Binding Crane1F.ServoPowerOffCommand}"
                            Btn3="伺服通电"
                            Btn3Command="{Binding Crane1F.ServoPowerOnCommand}"
                            Btn4="清除报警"
                            Btn4Command="{Binding Crane1F.ClearAlarmCommand}"
                            Btn5="充磁"
                            Btn5Command="{Binding Crane1F.MagnetOnCommand}"
                            Btn6="退磁"
                            Btn6Command="{Binding Crane1F.MagnetOffCommand}"
                            Btn7="开液盘"
                            Btn7Command="{Binding Crane1F.DrainOpenCommand}"
                            Btn8="关液盘"
                            Btn8Command="{Binding Crane1F.DrainCloseCommand}"
                            ConnectedBrush="{Binding Crane1F.ConnectedBrush}"
                            Line1="{Binding Crane1F.Line1}"
                            Line1Brush="{Binding Crane1F.Line1Brush}"
                            Line2="{Binding Crane1F.Line2}"
                            Line2Brush="{Binding Crane1F.Line2Brush}"
                            Line3="{Binding Crane1F.Line3}"
                            Line3Brush="{Binding Crane1F.Line3Brush}"
                            Line4="{Binding Crane1F.Line4}"
                            Line4Brush="{Binding Crane1F.Line4Brush}"
                            Line5="{Binding Crane1F.Line5}"
                            Line5Brush="{Binding Crane1F.Line5Brush}" />
                        <!--  1号线天车后  -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane1R.CraneName}"
                            Btn1="急停"
                            Btn1Command="{Binding Crane1R.EStopCommand}"
                            Btn2="伺服断电"
                            Btn2Command="{Binding Crane1R.ServoPowerOffCommand}"
                            Btn3="伺服通电"
                            Btn3Command="{Binding Crane1R.ServoPowerOnCommand}"
                            Btn4="清除报警"
                            Btn4Command="{Binding Crane1R.ClearAlarmCommand}"
                            Btn5="充磁"
                            Btn5Command="{Binding Crane1R.MagnetOnCommand}"
                            Btn6="退磁"
                            Btn6Command="{Binding Crane1R.MagnetOffCommand}"
                            Btn7="开液盘"
                            Btn7Command="{Binding Crane1R.DrainOpenCommand}"
                            Btn8="关液盘"
                            Btn8Command="{Binding Crane1R.DrainCloseCommand}"
                            ConnectedBrush="{Binding Crane1R.ConnectedBrush}"
                            Line1="{Binding Crane1R.Line1}"
                            Line1Brush="{Binding Crane1R.Line1Brush}"
                            Line2="{Binding Crane1R.Line2}"
                            Line2Brush="{Binding Crane1R.Line2Brush}"
                            Line3="{Binding Crane1R.Line3}"
                            Line3Brush="{Binding Crane1R.Line3Brush}"
                            Line4="{Binding Crane1R.Line4}"
                            Line4Brush="{Binding Crane1R.Line4Brush}"
                            Line5="{Binding Crane1R.Line5}"
                            Line5Brush="{Binding Crane1R.Line5Brush}" />
                        <!--  2号线天车前  -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane2F.CraneName}"
                            Btn1="急停"
                            Btn1Command="{Binding Crane2F.EStopCommand}"
                            Btn2="伺服断电"
                            Btn2Command="{Binding Crane2F.ServoPowerOffCommand}"
                            Btn3="伺服通电"
                            Btn3Command="{Binding Crane2F.ServoPowerOnCommand}"
                            Btn4="清除报警"
                            Btn4Command="{Binding Crane2F.ClearAlarmCommand}"
                            Btn5="充磁"
                            Btn5Command="{Binding Crane2F.MagnetOnCommand}"
                            Btn6="退磁"
                            Btn6Command="{Binding Crane2F.MagnetOffCommand}"
                            Btn7="开液盘"
                            Btn7Command="{Binding Crane2F.DrainOpenCommand}"
                            Btn8="关液盘"
                            Btn8Command="{Binding Crane2F.DrainCloseCommand}"
                            ConnectedBrush="{Binding Crane2F.ConnectedBrush}"
                            Line1="{Binding Crane2F.Line1}"
                            Line1Brush="{Binding Crane2F.Line1Brush}"
                            Line2="{Binding Crane2F.Line2}"
                            Line2Brush="{Binding Crane2F.Line2Brush}"
                            Line3="{Binding Crane2F.Line3}"
                            Line3Brush="{Binding Crane2F.Line3Brush}"
                            Line4="{Binding Crane2F.Line4}"
                            Line4Brush="{Binding Crane2F.Line4Brush}"
                            Line5="{Binding Crane2F.Line5}"
                            Line5Brush="{Binding Crane2F.Line5Brush}" />
                        <!--  2号线天车后  -->
                        <controls:OverviewDeviceCard
                            Title="{Binding Crane2R.CraneName}"
                            Btn1="急停"
                            Btn1Command="{Binding Crane2R.EStopCommand}"
                            Btn2="伺服断电"
                            Btn2Command="{Binding Crane2R.ServoPowerOffCommand}"
                            Btn3="伺服通电"
                            Btn3Command="{Binding Crane2R.ServoPowerOnCommand}"
                            Btn4="清除报警"
                            Btn4Command="{Binding Crane2R.ClearAlarmCommand}"
                            Btn5="充磁"
                            Btn5Command="{Binding Crane2R.MagnetOnCommand}"
                            Btn6="退磁"
                            Btn6Command="{Binding Crane2R.MagnetOffCommand}"
                            Btn7="开液盘"
                            Btn7Command="{Binding Crane2R.DrainOpenCommand}"
                            Btn8="关液盘"
                            Btn8Command="{Binding Crane2R.DrainCloseCommand}"
                            ConnectedBrush="{Binding Crane2R.ConnectedBrush}"
                            Line1="{Binding Crane2R.Line1}"
                            Line1Brush="{Binding Crane2R.Line1Brush}"
                            Line2="{Binding Crane2R.Line2}"
                            Line2Brush="{Binding Crane2R.Line2Brush}"
                            Line3="{Binding Crane2R.Line3}"
                            Line3Brush="{Binding Crane2R.Line3Brush}"
                            Line4="{Binding Crane2R.Line4}"
                            Line4Brush="{Binding Crane2R.Line4Brush}"
                            Line5="{Binding Crane2R.Line5}"
                            Line5Brush="{Binding Crane2R.Line5Brush}" />
                        <!--  研磨机天车  -->
                        <controls:OverviewDeviceCard
                            Title="{Binding CraneGL.CraneName}"
                            Btn1="急停"
                            Btn1Command="{Binding CraneGL.EStopCommand}"
                            Btn2="伺服断电"
                            Btn2Command="{Binding CraneGL.ServoPowerOffCommand}"
                            Btn3="伺服通电"
                            Btn3Command="{Binding CraneGL.ServoPowerOnCommand}"
                            Btn4="清除报警"
                            Btn4Command="{Binding CraneGL.ClearAlarmCommand}"
                            Btn5="充磁"
                            Btn5Command="{Binding CraneGL.MagnetOnCommand}"
                            Btn6="退磁"
                            Btn6Command="{Binding CraneGL.MagnetOffCommand}"
                            Btn7="开液盘"
                            Btn7Command="{Binding CraneGL.DrainOpenCommand}"
                            Btn8="关液盘"
                            Btn8Command="{Binding CraneGL.DrainCloseCommand}"
                            ConnectedBrush="{Binding CraneGL.ConnectedBrush}"
                            Line1="{Binding CraneGL.Line1}"
                            Line1Brush="{Binding CraneGL.Line1Brush}"
                            Line2="{Binding CraneGL.Line2}"
                            Line2Brush="{Binding CraneGL.Line2Brush}"
                            Line3="{Binding CraneGL.Line3}"
                            Line3Brush="{Binding CraneGL.Line3Brush}"
                            Line4="{Binding CraneGL.Line4}"
                            Line4Brush="{Binding CraneGL.Line4Brush}"
                            Line5="{Binding CraneGL.Line5}"
                            Line5Brush="{Binding CraneGL.Line5Brush}" />
                    </UniformGrid>

                    <UniformGrid Margin="0,2,0,4" Columns="3">
                        <controls:OverviewDeviceCard
                            Title="{Binding Manipulator1.Name}"
                            Btn1="急停"
                            Btn1Command="{Binding Manipulator1.EStopCommand}"
                            Btn2="伺服通电"
                            Btn2Command="{Binding Manipulator1.ServoPowerOnCommand}"
                            Btn3="伺服断电"
                            Btn3Command="{Binding Manipulator1.ServoPowerOffCommand}"
                            Btn4="清除报警"
                            Btn4Command="{Binding Manipulator1.ClearAlarmCommand}"
                            Btn5="Y+"
                            Btn5Command="{Binding Manipulator1.YPlusCommand}"
                            Btn6="Y-"
                            Btn6Command="{Binding Manipulator1.YMinusCommand}"
                            Btn7="Z+"
                            Btn7Command="{Binding Manipulator1.ZPlusCommand}"
                            Btn8="Z-"
                            Btn8Command="{Binding Manipulator1.ZMinusCommand}"
                            ConnectedBrush="{Binding Manipulator1.ConnectedBrush}"
                            Line1="{Binding Manipulator1.Line1}"
                            Line1Brush="{Binding Manipulator1.Line1Brush}"
                            Line2="{Binding Manipulator1.Line2}"
                            Line2Brush="{Binding Manipulator1.Line2Brush}"
                            Line3="{Binding Manipulator1.Line3}"
                            Line3Brush="{Binding Manipulator1.Line3Brush}"
