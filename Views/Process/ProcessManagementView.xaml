<UserControl
    x:Class="AutomaticOnlineHostComputer.Views.Process.ProcessManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F0F2F5">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="4" Orientation="Horizontal">
                    <TextBlock
                        Margin="4,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="工艺管理" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="1300" MinHeight="700">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid
                            x:Name="ProcessGrid"
                            MinHeight="90"
                            Margin="8,0,8,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#D9E0EA"
                            IsReadOnly="True"
                            VerticalGridLinesBrush="#D9E0EA"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="70"
                                    Binding="{Binding Id}"
                                    Header="机号" />
                                <DataGridTextColumn
                                    Width="140"
                                    Binding="{Binding Name}"
                                    Header="工艺名称" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step1}"
                                    Header="工序1" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step2}"
                                    Header="工序2" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step3}"
                                    Header="工序3" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step4}"
                                    Header="工序4" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step5}"
                                    Header="工序5" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step6}"
                                    Header="工序6" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step7}"
                                    Header="工序7" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step8}"
                                    Header="工序8" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step9}"
                                    Header="工序9" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding Step10}"
                                    Header="工序10" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="8,0,0,0"
            Background="White"
            BorderBrush="#BFC8D6"
            BorderThickness="1">
            <StackPanel Margin="8">
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="AddProcess_click"
                    Content="添加工艺" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="EditProcess_Click"
                    Content="编辑工艺" />
                <Button
                    Height="34"
                    Margin="0,0,0,8"
                    Click="DeleteProcess_Click"
                    Content="删除工艺" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>