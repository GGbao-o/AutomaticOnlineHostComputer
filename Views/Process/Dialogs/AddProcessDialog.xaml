<Window x:Class="AutomaticOnlineHostComputer.Views.Process.Dialogs.AddProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加工艺"
        Width="1020" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧录入区 -->
            <Border Grid.Column="0"
                    Padding="8"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="工艺名称" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="ProcessNameTextBox" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="1" Text="工序编号" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="StepNoTextBox" Grid.Row="1" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="2" Text="工序名称" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="StepNameTextBox" Grid.Row="2" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="3" Text="执行时间" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="ExecuteTimeTextBox" Grid.Row="3" Grid.Column="1" Margin="4,4,0,4" Height="28" Text="0"/>

                        <TextBlock Grid.Row="4" Text="使用设备" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="DeviceTextBox" Grid.Row="4" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="5" Text="机号" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="MachineNoTextBox" Grid.Row="5" Grid.Column="1" Margin="4,4,0,4" Height="28" Text="0"/>

                        <TextBlock Grid.Row="6" Text="安全位置" Margin="0,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="SafePositionTextBox" Grid.Row="6" Grid.Column="1" Margin="4,4,0,4" Height="28"/>

                        <TextBlock Grid.Row="7" Text="工序使能" Margin="0,8" VerticalAlignment="Center"/>
                        <CheckBox x:Name="EnabledCheckBox" Grid.Row="7" Grid.Column="1" Margin="4,8,0,4" Content="启用" IsChecked="True"/>

                        <TextBlock Grid.Row="8" Text="Z轴回零" Margin="0,8" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ZHomeCheckBox" Grid.Row="8" Grid.Column="1" Margin="4,8,0,4" Content="回零" IsChecked="True"/>

                        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Content="确定" Width="88" Height="34" Margin="0,0,10,0" Click="Save_Click"/>
                            <Button Content="取消" Width="88" Height="34" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 右侧工艺步骤预览 -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid Margin="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#FFE2E8F0"
                          VerticalGridLinesBrush="#FFE2E8F0"
                          Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="工艺名称" Binding="{Binding ProcessName}" Width="*" />
                        <DataGridTextColumn Header="工序编号" Binding="{Binding StepNo}" Width="*" />
                        <DataGridTextColumn Header="工序名称" Binding="{Binding StepName}" Width="*" />
                        <DataGridTextColumn Header="执行时间" Binding="{Binding ExecuteTime}" Width="*" />
                        <DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
