<Window x:Class="AutomaticOnlineHostComputer.Views.Process.Dialogs.AddProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加工艺"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F0F2F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Padding="12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="添加工艺" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                <Button Content="✕"
                        Width="28" Height="28"
                        DockPanel.Dock="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#D14343"
                        FontWeight="Bold"
                        Click="Close_Click"/>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <Border Grid.Row="1" Margin="0,12,0,12" Background="White" BorderBrush="#BFC8D6" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧表单 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 工艺名称 -->
                        <TextBlock Text="工艺名称" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"/>

                        <!-- 添加/修改按钮 -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                            <Button Content="添加" Width="60" Height="28" Margin="0,0,8,0"/>
                            <Button Content="修改" Width="60" Height="28"/>
                        </StackPanel>

                        <!-- 工序编号 -->
                        <TextBlock Grid.Row="2" Text="工序编号" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"/>

                        <!-- 工序名称 -->
                        <TextBlock Grid.Row="3" Text="工序名称" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"/>

                        <!-- 工序时间 -->
                        <TextBlock Grid.Row="4" Text="工序时间" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"/>

                        <!-- 使用设备 -->
                        <TextBlock Grid.Row="5" Text="使用设备" Margin="0,6" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="斜床" IsSelected="True"/>
                            <ComboBoxItem Content="双头镗"/>
                            <ComboBoxItem Content="研磨机"/>
                            <ComboBoxItem Content="打标机"/>
                            <ComboBoxItem Content="物料架"/>
                        </ComboBox>

                        <!-- 使能工序 -->
                        <TextBlock Grid.Row="6" Text="使能工序" Margin="0,6" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                            <RadioButton Content="开启" IsChecked="True" Margin="0,0,16,0" GroupName="EnableProcess"/>
                            <RadioButton Content="关闭" GroupName="EnableProcess"/>
                        </StackPanel>

                        <!-- Z轴回原点 -->
                        <TextBlock Grid.Row="7" Text="Z轴回原点" Margin="0,6" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,6" VerticalAlignment="Center">
                            <RadioButton Content="回原点" IsChecked="True" Margin="0,0,16,0" GroupName="ZHome"/>
                            <RadioButton Content="回安全位置" GroupName="ZHome"/>
                        </StackPanel>

                        <!-- 安全位置输入（可选） -->
                        <TextBlock Grid.Row="8" Text="安全位置" Margin="0,6" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"/>

                        <!-- 确认/取消 -->
                        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="确认" Width="80" Height="32" Margin="0,0,8,0"/>
                            <Button Content="取消" Width="80" Height="32" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 右侧表格 -->
                <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="1"
                                  Margin="8"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#D9E0EA"
                                  VerticalGridLinesBrush="#D9E0EA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="机号" Binding="{Binding MachineNo}" Width="60"/>
                                <DataGridTextColumn Header="工艺名称" Binding="{Binding ProcessName}" Width="120"/>
                                <DataGridTextColumn Header="工序执行时间" Binding="{Binding ExecuteTime}" Width="100"/>
                                <DataGridTextColumn Header="工序编号" Binding="{Binding StepNo}" Width="80"/>
                                <DataGridTextColumn Header="工序名称" Binding="{Binding StepName}" Width="120"/>
                                <DataGridTextColumn Header="使用设备" Binding="{Binding Device}" Width="100"/>
                                <DataGridTextColumn Header="回原位置" Binding="{Binding HomePosition}" Width="100"/>
                                <DataGridTextColumn Header="工序使能" Binding="{Binding Enabled}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>