<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutomaticOnlineHostComputer</RootNamespace>
    <AssemblyName>AutomaticOnlineHostComputer</AssemblyName>
    <!-- 关键：不要禁用默认编译项，让 SDK 自动包含所有 .cs 和 .xaml -->
    <!-- 不设置 EnableDefaultCompileItems 和 EnableDefaultPageItems -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.7.0" />
    <!--
      Microsoft.Extensions.DependencyInjection：
      微软官方 DI（依赖注入）容器库。
      作用：统一管理对象的创建和生命周期，避免在每个类里手动 new 依赖对象。
      版本 8.x 与 .NET 8 对应。
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 数据库配置文件，发布/运行时复制到输出目录 -->
    <None Update="dbsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Process\Dialogs\AddProcessDialog.cs">
      <DependentUpon>AddProcessDialog.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- 默认包含规则会自动包含项目目录下所有 .cs 和 .xaml 文件，递归子文件夹 -->
  <!-- 自动排除 bin, obj, .vs, .idea 等临时文件夹 -->
  <!-- 因此您无需手动编写任何 Compile 或 Page 条目 -->

  <!-- 如果有些文件夹您确实不想包含在项目中（例如备份文件夹），可以取消注释下面的代码 -->
  <!--
  <ItemGroup>
    <Compile Remove="OldBackup\**" />
    <Page Remove="OldBackup\**" />
  </ItemGroup>
  -->
</Project>