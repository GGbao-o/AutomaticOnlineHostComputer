<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBgColor">#FFF4F7FB</Color>
    <Color x:Key="PanelColor">#FFFFFFFF</Color>
    <Color x:Key="PanelBorderColor">#FFCBD5E1</Color>
    <Color x:Key="TextPrimaryColor">#FF0F172A</Color>
    <Color x:Key="TextSecondaryColor">#FF475569</Color>
    <Color x:Key="AccentColor">#FF0F5E98</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="DangerColor">#FFDC2626</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBgColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
</ResourceDictionary>