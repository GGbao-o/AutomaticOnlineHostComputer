<Window x:Class="AutomaticOnlineHostComputer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动线上位机"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Background="#F0F2F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="主界面"/>
            <MenuItem Header="天车管理"/>
            <MenuItem Header="机器管理"/>
            <MenuItem Header="控制器管理"/>
            <MenuItem Header="工艺管理"/>
        </Menu>
<!--主内容展示区-->
        <Grid Grid.Row="1" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="300"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1: 任务列表 -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="6">
                        <Button Content="添加任务" Width="84" Height="30" Margin="2"/>
                        <Button Content="启动一号线" Width="90" Height="30" Margin="2"/>
                        <Button Content="启动二号线" Width="90" Height="30" Margin="2"/>
                        <Button Content="启动研磨" Width="84" Height="30" Margin="2"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Margin="6"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="*"/>
                            <DataGridTextColumn Header="当前工序" Binding="{Binding Step}" Width="*"/>
                            <DataGridTextColumn Header="工件状态" Binding="{Binding State}" Width="*"/>
                            <DataGridTextColumn Header="交互" Binding="{Binding Action}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 2: 操作控制区（必须滚动） -->
            <Border Grid.Row="0" Grid.Column="1" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="320" MinHeight="560" Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="选择天车" Margin="4" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Margin="4" MinWidth="120">
                            <ComboBoxItem Content="1号天车"/>
                            <ComboBoxItem Content="2号天车"/>
                        </ComboBox>

                        <CheckBox Grid.Column="2" Content="自动控制" Margin="4" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Text="单次运动距离" Margin="4" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="4" Text="1000"/>
                        <CheckBox Grid.Row="1" Grid.Column="2" Content="手动控制" Margin="4" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Text="工件长度" Margin="4" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="4"/>

                        <UniformGrid Grid.Row="3" Grid.ColumnSpan="3" Columns="4" Margin="2">
                            <Button Content="X+" Margin="2" Height="32"/>
                            <Button Content="X-" Margin="2" Height="32"/>
                            <Button Content="停止运动" Margin="2" Height="32"/>
                            <Button Content="回原点" Margin="2" Height="32"/>
                            <Button Content="Y+" Margin="2" Height="32"/>
                            <Button Content="Y-" Margin="2" Height="32"/>
                            <Button Content="编码器归零" Margin="2" Height="32"/>
                            <Button Content="回零停止" Margin="2" Height="32"/>
                            <Button Content="Z+" Margin="2" Height="32"/>
                            <Button Content="Z-" Margin="2" Height="32"/>
                            <Button Content="磁铁吸合" Margin="2" Height="32"/>
                            <Button Content="磁铁释放" Margin="2" Height="32"/>
                            <Button Content="急停恢复" Margin="2" Height="32"/>
                            <Button Content="清除故障" Margin="2" Height="32"/>
                            <Button Content="接触器打开" Margin="2" Height="32"/>
                            <Button Content="接触器关闭" Margin="2" Height="32"/>
                        </UniformGrid>

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="激光测距: -1" Margin="6,10,6,0" FontWeight="Bold"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 3: 天车和机械手黄台（必须滚动） -->
            <Border Grid.Row="0" Grid.Column="2" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="#FFFDF4D6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6" MinWidth="1400" MinHeight="560">
                        <TextBlock Text="天车 / 机械手 黄台总览" FontSize="16" FontWeight="Bold" Margin="2,2,2,8"/>

                        <UniformGrid Columns="5" Margin="0,0,0,8">
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6"><TextBlock Text="1-天车" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6"><TextBlock Text="2-天车" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6"><TextBlock Text="3-天车" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6"><TextBlock Text="4-天车" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6"><TextBlock Text="5-天车" HorizontalAlignment="Center"/></Border>
                        </UniformGrid>

                        <UniformGrid Columns="5" Margin="0,0,0,8">
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6"><TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6"><TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6"><TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6"><TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6"><TextBlock Text="急停X/驱动X/正极X/..." Foreground="White" HorizontalAlignment="Center"/></Border>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6"><TextBlock Text="1-机械手" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6"><TextBlock Text="2-机械手" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="White" Margin="3" Padding="6"><TextBlock Text="3-机械手" HorizontalAlignment="Center"/></Border>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,0,0,4">
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6"><TextBlock Text="急停Y/驱动Y/正极Y/..." Foreground="White" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6"><TextBlock Text="急停Y/驱动Y/正极Y/..." Foreground="White" HorizontalAlignment="Center"/></Border>
                            <Border BorderBrush="#CED4DE" BorderThickness="1" Background="#2C86C8" Margin="3" Padding="6"><TextBlock Text="急停Y/驱动Y/正极Y/..." Foreground="White" HorizontalAlignment="Center"/></Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 4: 全厂下位机 / 流程图机器状态（必须滚动） -->
            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="4" BorderBrush="#BFC8D6" BorderThickness="1" Background="White">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6" MinWidth="1900" MinHeight="520">
                        <TextBlock Text="全厂下位机状态 / 全流程机器状态图" FontSize="16" FontWeight="Bold" Margin="2,2,2,10"/>

                        <WrapPanel>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="01总上料架" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="02机械手1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="03中转站1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="04中转站2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="05中转站3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="11货叉1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="12货叉2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="18双头镗床" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="19打标机" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="25二号斜床" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="26三号斜床" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="研磨机1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="研磨机2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="研磨机3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                            <Border Width="170" Height="110" Margin="3" BorderBrush="#CED4DE" BorderThickness="1" Background="#EEF3F8"><TextBlock Text="研磨机4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
