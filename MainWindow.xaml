<Window x:Class="AutomaticOnlineHostComputer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="自动线上位机"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F7F8FA">
            <MenuItem Header="主界面" Tag="main" Click="MenuItem_Click" />
            <MenuItem Header="天车管理" Tag="crane" Click="MenuItem_Click" />
            <MenuItem Header="机器管理" Tag="machine" Click="MenuItem_Click" />
            <MenuItem Header="控制器管理" Tag="controller" Click="MenuItem_Click" />
            <MenuItem Header="工艺管理" Tag="process" Click="MenuItem_Click" />
            <MenuItem Header="运动参数设置" Tag="motion" Click="MenuItem_Click" />
            <MenuItem Header="设备总览" Tag="overview" Click="MenuItem_Click" />
            <MenuItem Header="全流程状态" Tag="flowStatus" Click="MenuItem_Click" />
        </Menu>

        <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="4" />
    </Grid>
</Window>
