<Window
    x:Class="AutomaticOnlineHostComputer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="万美自动线控制平台"
    Width="1200"
    Height="750"
    Background="{StaticResource AppBackgroundBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#26323F" Foreground="White">
            <MenuItem
                Click="MenuItem_Click"
                Header="主界面"
                Tag="main" />
            <MenuItem
                Click="MenuItem_Click"
                Header="天车管理"
                Tag="crane" />
            <MenuItem
                Click="MenuItem_Click"
                Header="机器管理"
                Tag="machine" />
            <MenuItem
                Click="MenuItem_Click"
                Header="控制器管理"
                Tag="controller" />
            <MenuItem
                Click="MenuItem_Click"
                Header="工艺管理"
                Tag="process" />
            <MenuItem
                Click="MenuItem_Click"
                Header="运动参数设置"
                Tag="motion" />
            <MenuItem
                Click="MenuItem_Click"
                Header="设备总览"
                Tag="overview" />
            <MenuItem
                Click="MenuItem_Click"
                Header="全流程状态"
                Tag="flowStatus" />
            <MenuItem
                Click="MenuItem_Click"
                Header="异常监控"
                Tag="attentionMonitor" />
        </Menu>

        <ContentControl
            x:Name="ContentHost"
            Grid.Row="1"
            Margin="4" />
    </Grid>
</Window>
